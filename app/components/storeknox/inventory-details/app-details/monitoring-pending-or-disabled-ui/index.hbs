<Storeknox::InventoryDetails::SectionInfo
  @width='full'
  @spacing='4'
  @direction='column'
  @alignItems='center'
  @justifyContent='center'
  class='p-6'
  {{style minHeight='300px'}}
>
  {{#if @skInventoryApp.isDecommissioned}}
    <AkSvg::SoxMonitoringResultsPendingWithMonitoringOff
      data-test-storeknoxInventoryDetails-decommissionedIllustration
    />

    <AkStack
      @direction='column'
      @alignItems='center'
      @spacing='0.5'
      {{style maxWidth='485px'}}
    >
      <AkTypography
        @variant='h5'
        @align='center'
        data-test-storeknoxInventoryDetails-decommissionedHeaderText
      >
        {{t 'storeknox.appDecommissionedHeading'}}
      </AkTypography>

      <AkTypography
        @align='center'
        data-test-storeknoxInventoryDetails-decommissionedDescription
      >
        {{t 'storeknox.decommissionedMsg'}}
      </AkTypography>
    </AkStack>

  {{else if @skInventoryApp.monitoringEnabled}}
    <AkSvg::SoxMonitoringResultsPending
      data-test-storeknoxInventoryDetails-monitoringResultsPendingIllustration
    />

    <AkTypography
      @align='center'
      {{style maxWidth='500px'}}
      data-test-storeknoxInventoryDetails-monitoringResultsPendingText
    >
      {{t 'storeknox.monitoringResultsPending'}}
    </AkTypography>

  {{else}}
    <AkSvg::SoxMonitoringResultsPendingWithMonitoringOff
      data-test-storeknoxInventoryDetails-monitoringDisabledWithNoResultsIllustration
    />

    <AkStack
      @direction='column'
      @alignItems='center'
      @spacing='0.5'
      {{style maxWidth='485px'}}
    >
      <AkTypography
        @variant='h5'
        @align='center'
        data-test-storeknoxInventoryDetails-monitoringDisabledWithNoResultsHeaderText
      >
        {{t 'storeknox.enableMonitoringForApp'}}
      </AkTypography>

      <AkTypography
        @align='center'
        data-test-storeknoxInventoryDetails-monitoringDisabledWithNoResultsOff
      >
        {{t 'storeknox.monitoringDisabledWithNoResults'}}
      </AkTypography>
    </AkStack>
  {{/if}}
</Storeknox::InventoryDetails::SectionInfo>