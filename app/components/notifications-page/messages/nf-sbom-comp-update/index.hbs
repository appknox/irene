<AkStack @direction='column' @spacing='1.5'>
  <AkTypography data-test-nf-sbom-comp-update-primary-message>
    {{t 'notificationModule.messages.nf-sbom-comp-update'}}
  </AkTypography>

  <div local-class='component-card' data-test-nf-sbom-comp-update-card>
    <AkTypography local-class='component-name' @tag='p' @fontWeight='bold'>
      {{@context.displayName}}
    </AkTypography>

    <div local-class='component-details'>
      <AkTypography @tag='p' @color='textSecondary'>
        {{t 'notificationModule.newVersion'}}:
        <AkTypography
          @tag='span'
          @color='textPrimary'
          @fontWeight='bold'
        >{{@context.new_version}}</AkTypography>
      </AkTypography>

      <AkTypography @tag='p' @color='textSecondary'>
        {{t 'notificationModule.affects'}}:
        <AkTypography
          @tag='span'
          @color='textPrimary'
          @fontWeight='bold'
        >{{@context.affected_apps_count}}</AkTypography>
      </AkTypography>
    </div>
  </div>

  <AkStack @spacing='1.5'>
    <AkLink
      data-test-nf-sbom-comp-update-link
      @color='primary'
      @route='authenticated.dashboard.sbom.component-inventory'
      @query={{hash component_query=@context.component_name}}
      @underline='always'
      @title={{t 'notificationModule.viewComponent'}}
    >
      {{t 'notificationModule.viewComponent'}}
    </AkLink>

    <AkLink
      data-test-nf-sbom-comp-update-directory-link
      @color='textPrimary'
      @route='authenticated.dashboard.sbom.apps'
      @underline='always'
      @title={{t 'notificationModule.viewDirectory'}}
    >
      {{t 'notificationModule.viewDirectory'}}
    </AkLink>
  </AkStack>
</AkStack>
