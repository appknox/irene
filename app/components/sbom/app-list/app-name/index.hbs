<AkStack @alignItems='center' @spacing='1.5'>
  <Sbom::AppLogo @sbomProject={{@sbomProject}} />

  <AkStack
    @direction='column'
    @spacing='0.5'
    {{style maxWidth='calc(100% - 40px)'}}
  >
    <AkStack @alignItems='center' @spacing='0.5'>
      <AkTypography
        data-test-sbomApp-packageName
        @noWrap={{true}}
        title={{this.packageName}}
        {{style width='100%'}}
      >
        {{this.packageName}}
      </AkTypography>

      {{#if this.isStale}}
        <AkTooltip
          @title={{this.staleTooltip}}
          @arrow={{true}}
          @placement='bottom'
        >
          <AkIcon
            data-test-sbomApp-staleIcon
            @iconName='mdi:clock-alert-outline'
            @size='small'
            @color='warn'
          />
        </AkTooltip>
      {{/if}}
    </AkStack>

    <AkTypography data-test-sbomApp-name @tag='span' @color='textSecondary'>
      {{this.name}}
    </AkTypography>
  </AkStack>
</AkStack>