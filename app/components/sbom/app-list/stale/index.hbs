{{#if @sbomProject.latestSbFile}}
  {{#if this.isStale}}
    <AkStack @alignItems='center' @justifyContent='center' data-test-sbomApp-stale>
      <AkTooltip @title={{this.tooltip}} @arrow={{true}} @placement='bottom'>
        <AkIcon
          data-test-sbomApp-staleIcon
          @size='small'
          @iconName='mdi:clock-alert-outline'
          @color='warn'
        />
      </AkTooltip>
    </AkStack>
  {{else}}
    <AkTypography data-test-sbomApp-stale-none @color='textSecondary'>
      -
    </AkTypography>
  {{/if}}
{{else}}
  <AkTypography @color='textSecondary'>-</AkTypography>
{{/if}}
