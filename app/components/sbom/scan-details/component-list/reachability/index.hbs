<div data-test-sbomComponent-reachability>
  {{#if this.scanning}}
    <AkChip
      data-test-sbomComponent-reachabilityAnalyzing
      @variant='semi-filled'
      @size='small'
      @color='default'
      @label={{t 'sbomModule.reachability.analyzing'}}
    />
  {{else if this.scanNotRun}}
    {{#if this.scanStatusReason}}
      <AkTooltip
        @arrow={{true}}
        @placement='top'
        data-test-sbomComponent-reachabilityNotRunTooltip
      >
        <:default>
          <AkTypography
            data-test-sbomComponent-reachabilityNotRun
            @fontWeight='bold'
          >
            -
          </AkTypography>
        </:default>

        <:tooltipContent>
          <div
            {{style
              width='360px'
              white-space='pre-line'
              overflow-wrap='break-word'
            }}
          >{{this.scanStatusReason}}</div>
        </:tooltipContent>
      </AkTooltip>
    {{else}}
      <AkTypography
        data-test-sbomComponent-reachabilityNotRun
        @fontWeight='bold'
      >
        -
      </AkTypography>
    {{/if}}
  {{else if this.notApplicable}}
    {{! Not vulnerable: nothing to analyze, so a quiet dash, not a label. }}
    <AkTypography
      data-test-sbomComponent-reachabilityNotApplicable
      @color='textSecondary'
    >
      –
    </AkTypography>
  {{else}}
    <Sbom::ReachabilityStatus
      @verdict={{this.verdict}}
      @exposure={{this.exposure}}
      @compact={{true}}
    />
  {{/if}}
</div>