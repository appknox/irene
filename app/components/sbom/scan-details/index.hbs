<div class='py-1' data-test-sbomScanDetails-container>
  {{#unless this.isOriginalAnalysis}}
  <Sbom::SummaryHeader>
    <:summary>
      <AkStack @alignItems='center' @spacing='1.5'>
        <Sbom::AppLogo @sbomProject={{@sbomProject}} />

        <AkTypography data-test-sbomAppSummary-appPackageName @variant='h6'>
          {{this.packageName}}
        </AkTypography>

        <Sbom::AppPlatform @sbomProject={{@sbomProject}} />
      </AkStack>
    </:summary>

    <:actionBtn>
      <AkStack @alignItems='stretch' @spacing='1'>
        <AkLink
          @class={{this.classes.akLinkBtn}}
          @route='authenticated.dashboard.sbom.app-scans'
          @model={{@sbomProject.id}}
          @underline='none'
          data-test-sbomScanDetails-pastSbomAnalyses-link
        >
          {{t 'sbomModule.pastSbomAnalyses'}}
        </AkLink>

        {{#if this.scanStatusCompleted}}
          <AkButton
            {{on 'click' this.handleViewReportDrawerOpen}}
            data-test-sbomScanDetails-viewReport-btn
          >
            {{t 'sbomModule.viewReport'}}
          </AkButton>
        {{/if}}
      </AkStack>
    </:actionBtn>

    <:collapsibleContent>
      <Sbom::ScanDetails::FileScanSummary
        @sbomFile={{@sbomFile}}
        @sbomScanSummary={{@sbomScanSummary}}
      />
    </:collapsibleContent>
  </Sbom::SummaryHeader>
  {{/unless}}

  {{#if this.scanStatusCompleted}}
    {{#unless this.isOriginalAnalysis}}
      <Sbom::ScanDetails::Overview
        @sbomFile={{@sbomFile}}
        @sbomScanSummary={{@sbomScanSummary}}
      />
    {{/unless}}

    {{#if this.isNotOutdated}}
      <AkStack
        data-test-sbomScanDetails-switch-header
        local-class='switch-view-header'
        @alignItems='center'
        @justifyContent='space-between'
      >
        <AkStack @direction='column' @spacing='0.25'>
          {{#if this.hasReachability}}
            <AkTypography
              data-test-sbomScanDetails-viewTitle
              @variant='subtitle1'
            >
              {{if
                this.isOriginalAnalysis
                (t 'sbomModule.originalAnalysis.title')
                (t 'sbomModule.reachabilityInsights.title')
              }}
            </AkTypography>
          {{/if}}

          {{#if this.isOriginalAnalysis}}
            <AkTypography
              data-test-sbomScanDetails-viewSubtitle
              @variant='body2'
              @color='textSecondary'
            >
              {{t
                'sbomModule.originalAnalysis.subtitle'
                count=this.totalComponentCount
              }}
            </AkTypography>
          {{/if}}
        </AkStack>

        <AkStack @alignItems='center' @spacing='2'>
          {{#if (and this.hasReachability this.isOriginalAnalysis)}}
            <AkLink
              data-test-sbomScanDetails-backToInsights-link
              @route='authenticated.dashboard.sbom.scan-details'
              @models={{this.scanRouteModels}}
              @underline='always'
              @fontWeight='medium'
            >
              {{t 'sbomModule.reachabilityInsights.backLink'}}
            </AkLink>
          {{else if this.hasReachability}}
            <AkLink
              data-test-sbomScanDetails-originalAnalysis-link
              @route='authenticated.dashboard.sbom.original-analysis'
              @models={{this.scanRouteModels}}
              @underline='always'
              @fontWeight='medium'
            >
              {{t 'sbomModule.originalAnalysis.link'}}
            </AkLink>
          {{/if}}

          {{#unless this.isTreeView}}
            <div {{style width='180px'}}>
              <AkTextField
                data-test-sbomScanDetails-componentSearchInput
                @placeholder={{t 'sbomModule.searchComponents'}}
                @value={{this.sbomScanDetailsService.searchQuery}}
                {{on 'input' this.handleSearchInput}}
              >
                <:leftAdornment>
                  <AkIcon @iconName='search' @color='textSecondary' />
                </:leftAdornment>
              </AkTextField>
            </div>
          {{/unless}}
        </AkStack>

        {{#if this.showViewToggle}}
        <AkStack>
          {{#if this.isTreeView}}
            <AkButton
              data-test-sbomScanDetails-collapseAllButton
              {{on 'click' this.collapseAll}}
              @variant='outlined'
              @color='neutral'
              @disabled={{not this.isTreeExpanded}}
              local-class='toggle-button'
              class='mr-2'
            >
              <:leftIcon>
                <AkIcon @iconName='unfold-less' />
              </:leftIcon>

              <:default>
                {{t 'collapseAll'}}
              </:default>
            </AkButton>
          {{/if}}

          <AkIconButton
            local-class='switch-button tree {{if this.isTreeView "active"}}'
            @variant='outlined'
            @size='medium'
            {{on 'click' this.handleTreeViewClick}}
            data-test-sbomScanDetails-switch-treeViewButton
          >
            <AkIcon
              @color={{if this.isTreeView 'primary'}}
              @iconName='account-tree'
            />
          </AkIconButton>

          <AkIconButton
            local-class='switch-button list {{if this.isTreeView "" "active"}}'
            @variant='outlined'
            {{on 'click' this.handleListViewClick}}
            data-test-sbomScanDetails-switch-listViewButton
          >
            <AkIcon
              @color={{unless this.isTreeView 'primary'}}
              @iconName='format-list-bulleted'
            />
          </AkIconButton>
        </AkStack>
        {{/if}}
      </AkStack>
    {{/if}}

    {{#if (and this.isTreeView this.isNotOutdated)}}
      <Sbom::ScanDetails::ComponentTree
        @sbomProject={{@sbomProject}}
        @sbomFile={{@sbomFile}}
        @packageName={{this.packageName}}
        @updateExpandedNodes={{this.updateExpandedNodes}}
        @expandedNodes={{this.expandedNodes}}
        @treeNodes={{this.treeNodes}}
        @updateTreeNodes={{this.updateTreeNodes}}
      />
    {{else}}
      <Sbom::ScanDetails::ComponentList
        @sbomProject={{@sbomProject}}
        @sbomFile={{@sbomFile}}
        @sbomScanSummary={{@sbomScanSummary}}
        @view={{if this.isOriginalAnalysis 'original' 'insights'}}
        @showReachability={{this.hasReachability}}
        class={{if this.isNotOutdated '' 'mt-2'}}
        data-test-sbomScanDetails-componentList-container
      />
    {{/if}}
  {{else}}
    <AkStack
      @direction='column'
      @justifyContent='center'
      @alignItems='center'
      class='mt-2'
      local-class='scan-status-container'
    >
      {{#if this.scanStatusFailed}}
        <AkSvg::NoResult data-test-sbomScanDetails-scanStatusFailedSvg />
      {{else}}
        <AkSvg::InProgress data-test-sbomScanDetails-scanStatusInProgressSvg />
      {{/if}}

      <AkStack
        class='mt-5'
        @direction='column'
        @alignItems='center'
        @spacing='1'
      >
        <AkTypography data-test-sbomScanDetails-scanStatusTitle @variant='h5'>
          {{this.scanStatusText.title}}
        </AkTypography>

        <AkTypography
          data-test-sbomScanDetails-scanStatusDescription
          {{style width='600px'}}
          @color='textSecondary'
          @align='center'
        >
          {{this.scanStatusText.description}}
        </AkTypography>
      </AkStack>

      <AkStack
        @spacing='1'
        @alignItems='center'
        class='mt-4'
        data-test-sbomScanDetails-scanStages
      >
        {{#each this.scanStages as |stage|}}
          {{#if stage.error}}
            <AkTooltip
              @arrow={{true}}
              @placement='top'
              data-test-sbomScanDetails-scanStageErrorTooltip
            >
              <:default>
                <AkChip
                  @variant='semi-filled'
                  @size='small'
                  @color={{stage.color}}
                  @label='{{stage.label}}: {{stage.statusText}}'
                  data-test-sbomScanDetails-scanStageChip
                />
              </:default>

              <:tooltipContent>
                <div
                  {{style width='360px' white-space='pre-line' overflow-wrap='break-word'}}
                >{{stage.error}}</div>
              </:tooltipContent>
            </AkTooltip>
          {{else}}
            <AkChip
              @variant='semi-filled'
              @size='small'
              @color={{stage.color}}
              @label='{{stage.label}}: {{stage.statusText}}'
              data-test-sbomScanDetails-scanStageChip
            />
          {{/if}}
        {{/each}}
      </AkStack>
    </AkStack>
  {{/if}}
</div>

<Sbom::ScanReportDrawer
  @sbomFile={{@sbomFile}}
  @open={{this.openViewReportDrawer}}
  @onClose={{this.handleViewReportDrawerClose}}
/>