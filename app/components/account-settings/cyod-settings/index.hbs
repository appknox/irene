{{#if this.visible}}
  <div
    local-class='cyod-settings-container'
    data-test-cyodSettings
    ...attributes
  >
    {{! Spacing lives on the stack rather than margin utilities: AkTypography
    sets its own margin-bottom, which silently overrides mb-* classes. }}
    <AkStack @direction='column' @spacing='3'>
      <AkTypography @variant='h5' data-test-cyodSettings-title>
        {{t 'cyodRegistration.title'}}
      </AkTypography>

      {{#if this.isRegistrationEnabled}}
        {{! Device Registration }}
        {{! @width='full' so the button lands on the table's right edge below;
        without it the row only spans its content. }}
        <AkStack
          @width='full'
          @alignItems='flex-start'
          @justifyContent='space-between'
          @spacing='2'
        >
          <AkStack @direction='column' @spacing='1'>
            <AkTypography
              @variant='subtitle1'
              data-test-cyodSettings-registerTitle
            >
              {{t 'cyodSettings.deviceRegistration'}}
            </AkTypography>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'cyodSettings.deviceRegistrationDesc'}}
            </AkTypography>
          </AkStack>

          <AkButton
            data-test-cyodSettings-registerBtn
            @variant='filled'
            {{on 'click' this.handleOpen}}
          >
            {{t 'cyodSettings.registerADevice'}}
          </AkButton>
        </AkStack>

        <AkDivider @color='light' />

        {{! Your connected device }}
        <Cyod::DeviceTable
          @heading={{t 'cyodSettings.connectedDevice'}}
          @subheading={{t 'cyodSettings.connectedDeviceDesc'}}
          {{! Emphasises "Register a device", pointing at the button above. It is
          deliberately not a link -- the button is the affordance. }}
          @emptyHint={{t 'cyodSettings.emptyHint' htmlSafe=true}}
          @onlyConnected={{true}}
        />
      {{else}}
        {{! The owner's switch is off, so there is nothing a member can do here.
        The whole surface collapses to one notice pointing at the owner, rather
        than showing a dead register button over an empty table.

        ToggleAutomatedDast is the illustration the design uses here -- the same
        one that prompts you to switch automated DAST on
        (file-details/dynamic-scan/automated). TurnOnSettings looks close by name
        but is a much simpler 5-path mark and does not match. }}
        <div local-class='disabled-state' data-test-cyodSettings-disabled>
          <AkStack
            @direction='column'
            @alignItems='center'
            @justifyContent='center'
            @spacing='1'
            class='py-7 px-4'
          >
            <AkSvg::ToggleAutomatedDast data-test-cyodSettings-disabledSvg />

            <AkTypography
              @variant='h5'
              class='mt-4'
              data-test-cyodSettings-disabledTitle
            >
              {{t 'cyodSettings.turnOnTitle'}}
            </AkTypography>

            <AkTypography
              @align='center'
              @color='textSecondary'
              data-test-cyodSettings-disabledDesc
            >
              {{t 'cyodSettings.turnOnDesc'}}
            </AkTypography>
          </AkStack>
        </div>
      {{/if}}
    </AkStack>
  </div>

  <AkDrawer
    @open={{this.showDrawer}}
    @onClose={{this.handleClose}}
    @anchor='right'
    as |dr|
  >
    <div
      data-test-cyodSettings-drawer
      local-class='register-drawer'
      {{style height='100%'}}
    >
      <AkAppbar @justifyContent='space-between' @color='dark' as |ab|>
        <AkTypography
          data-test-cyodSettings-drawerTitle
          @variant='h5'
          @color='inherit'
        >
          {{t 'cyodSettings.registerADevice'}}
        </AkTypography>

        <AkIconButton
          data-test-cyodSettings-drawerCloseBtn
          class={{ab.classes.defaultIconBtn}}
          {{on 'click' dr.closeHandler}}
        >
          <AkIcon @iconName='close' />
        </AkIconButton>
      </AkAppbar>

      <AkStack @direction='column' @spacing='3' class='p-4'>
        <AkStack @direction='column' @spacing='1'>
          <AkTypography @variant='subtitle1'>
            {{t 'cyodSettings.yourRegisteredDevices'}}
          </AkTypography>

          <AkTypography @variant='body2' @color='textSecondary'>
            {{t 'cyodSettings.stepsIntro'}}
          </AkTypography>
        </AkStack>

        {{! Step 1 — iOS signing certificate }}
        <AkStack local-class='setup-step' @spacing='1' @alignItems='flex-start'>
          <div local-class='step-num' aria-hidden='true'>1</div>

          <AkStack @direction='column' @spacing='0.5'>
            <AkTypography @variant='body2'>
              {{t 'cyodSettings.stepCertificate'}}
            </AkTypography>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'cyodSettings.stepCertificateNote'}}
            </AkTypography>
          </AkStack>
        </AkStack>

        {{! Step 2 — download the app }}
        <AkStack local-class='setup-step' @spacing='1' @alignItems='flex-start'>
          <div local-class='step-num' aria-hidden='true'>2</div>

          <AkStack @direction='column' @spacing='0.5'>
            <AkTypography @variant='body2'>
              {{t 'cyodSettings.stepDownload'}}
            </AkTypography>

            <AkButton
              data-test-cyodSettings-downloadBtn
              @tag='a'
              href={{this.mercerDownloadUrl}}
              target='_blank'
              rel='noopener noreferrer'
              @variant='filled'
            >
              <AkIcon @iconName='download' @size='small' />

              <span class='ml-1'>{{t 'cyodSettings.downloadMercer'}}</span>
            </AkButton>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'cyodSettings.stepDownloadNote'}}
            </AkTypography>
          </AkStack>
        </AkStack>

        {{! Step 3 — sign in with token + server URL }}
        <AkStack local-class='setup-step' @spacing='1' @alignItems='flex-start'>
          <div local-class='step-num' aria-hidden='true'>3</div>

          <AkStack @direction='column' @spacing='0.5'>
            <AkTypography @variant='body2'>
              {{t 'cyodSettings.stepSignIn'}}
            </AkTypography>

            <AkStack
              local-class='url-field'
              @spacing='1'
              @alignItems='center'
              @justifyContent='space-between'
            >
              <AkTypography
                data-test-cyodSettings-serverUrl
                local-class='url-value'
                @variant='body3'
              >
                {{this.serverUrl}}
              </AkTypography>

              <AkClipboard @onSuccess={{this.handleCopySuccess}} as |ac|>
                <AkIconButton
                  data-test-cyodSettings-copyBtn
                  data-clipboard-text={{this.serverUrl}}
                  id={{ac.triggerId}}
                  @size='small'
                >
                  <AkIcon @iconName='content-copy-outline' @color='primary' />
                </AkIconButton>
              </AkClipboard>
            </AkStack>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'cyodSettings.stepSignInNote'}}
            </AkTypography>
          </AkStack>
        </AkStack>

        {{! Step 4 — register the device in the app }}
        <AkStack local-class='setup-step' @spacing='1' @alignItems='flex-start'>
          <div local-class='step-num' aria-hidden='true'>4</div>

          <AkTypography @variant='body2'>
            {{t 'cyodSettings.stepRegister'}}
          </AkTypography>
        </AkStack>

        {{! Step 5 — start the proxy }}
        <AkStack local-class='setup-step' @spacing='1' @alignItems='flex-start'>
          <div local-class='step-num' aria-hidden='true'>5</div>

          <AkTypography @variant='body2'>
            {{t 'cyodSettings.stepRun'}}
          </AkTypography>
        </AkStack>
      </AkStack>
    </div>
  </AkDrawer>
{{/if}}
