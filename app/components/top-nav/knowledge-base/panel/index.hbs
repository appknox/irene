<AkDrawer
  @open={{true}}
  @anchor='right'
  @onClose={{@onClose}}
  @drawerContainerClass={{this.drawerContainerClass}}
  as |dr|
>
  <div local-class='panel-root' data-test-knowledgeBasePanel>
    <div local-class='panel-header'>
      <div local-class='panel-header-actions'>
        {{#if this.showBackButton}}
          <button
            type='button'
            local-class='panel-header-btn panel-back-btn'
            {{on 'click' this.goBack}}
            data-test-knowledgeBasePanel-backBtn
          >
            <AkIcon @iconName='arrow-back' @size='small' @color='inherit' />
            <span>{{t 'back'}}</span>
          </button>
        {{/if}}

        <button
          type='button'
          aria-label={{t 'close'}}
          local-class='panel-header-btn panel-close-btn'
          {{on 'click' dr.closeHandler}}
          data-test-knowledgeBasePanel-closeBtn
        >
          <AkIcon @iconName='close' @color='inherit' />
        </button>
      </div>

      {{#unless this.showBackButton}}
        <h2 local-class='panel-title' data-test-knowledgeBasePanel-title>
          {{t 'knowledgeBasePanel.welcome'}}
        </h2>
      {{/unless}}
    </div>

    <div local-class='panel-card' data-test-knowledgeBasePanel-card>
      {{#if this.article}}
        <TopNav::KnowledgeBase::Panel::Article @article={{this.article}} />
      {{else if this.fetchArticle.isRunning}}
        <div local-class='panel-loader' data-test-knowledgeBasePanel-loader>
          <AkLoader @size={{24}} />
        </div>
      {{else if this.hasError}}
        <div local-class='panel-error' data-test-knowledgeBasePanel-error>
          <AkSvg::NoResult local-class='panel-error-svg' />

          <AkTypography @variant='h6' data-test-knowledgeBasePanel-errorTitle>
            {{t 'knowledgeBasePanel.errorTitle'}}
          </AkTypography>

          <AkTypography @color='textSecondary'>
            {{t 'knowledgeBasePanel.errorDescription'}}
          </AkTypography>
        </div>
      {{else}}
        <AkTypography
          @variant='h5'
          local-class='panel-card-title'
          data-test-knowledgeBasePanel-gotQuestions
        >
          {{t 'knowledgeBasePanel.gotQuestions'}}
        </AkTypography>

        <AkTextField
          @placeholder={{t 'knowledgeBasePanel.searchPlaceholder'}}
          @value={{this.searchQuery}}
          @autofocus={{true}}
          {{on 'input' this.handleSearchInput}}
          data-test-knowledgeBasePanel-searchInput
        >
          <:rightAdornment>
            <span local-class='panel-search-icon'>
              <AkIcon @iconName='search' @size='small' @color='inherit' />
            </span>
          </:rightAdornment>
        </AkTextField>

        <AkTypography
          @variant='body2'
          @color='textSecondary'
          local-class='panel-list-label'
          data-test-knowledgeBasePanel-listLabel
        >
          {{#if this.isSearching}}
            {{t 'knowledgeBasePanel.searchResults'}}
          {{else}}
            {{t 'knowledgeBasePanel.suggestedArticles'}}
          {{/if}}
        </AkTypography>

        {{#if this.isLoading}}
          <div local-class='panel-loader' data-test-knowledgeBasePanel-loader>
            <AkLoader @size={{24}} />
          </div>
        {{else if this.showNoArticles}}
          <AkTypography
            @color='textSecondary'
            local-class='panel-empty'
            data-test-knowledgeBasePanel-noArticles
          >
            {{t 'knowledgeBasePanel.noArticles'}}
          </AkTypography>
        {{else}}
          <ul local-class='panel-article-list'>
            {{#each this.articles as |item|}}
              <li>
                <button
                  type='button'
                  local-class='panel-article-item'
                  {{on 'click' (fn this.openArticle item)}}
                  data-test-knowledgeBasePanel-articleItem='{{item.id}}'
                >
                  <AkIcon
                    @iconName='import-contacts'
                    @size='small'
                    @color='textSecondary'
                  />

                  <span local-class='panel-article-text'>
                    <span
                      local-class='panel-article-title'
                      data-test-knowledgeBasePanel-articleTitle
                    >
                      {{item.title}}
                    </span>

                    {{#if item.snippet}}
                      <span
                        local-class='panel-article-snippet'
                        data-test-knowledgeBasePanel-articleSnippet
                      >
                        {{item.snippet}}
                      </span>
                    {{/if}}
                  </span>
                </button>
              </li>
            {{/each}}
          </ul>
        {{/if}}
      {{/if}}
    </div>
  </div>
</AkDrawer>