{{#if this.showKnowledgeBase}}
  <AkButton
    class={{@triggerBtnClass}}
    {{on 'click' this.onOpenKnowledgeBase}}
    data-test-topNav-KnowledgeBaseBtn
  >
    <:leftIcon>
      <AkIcon @iconName='import-contacts' />
    </:leftIcon>

    <:default>{{t 'knowledgeBase'}}</:default>
  </AkButton>
{{/if}}
{{#if this.knowledgeBase.isPanelOpen}}
  {{! Out of the top nav's flex row: the drawer's wormhole leaves an empty element here. }}
  <div local-class='panel-mount'>
    <TopNav::KnowledgeBase::Panel @onClose={{this.onClosePanel}} />
  </div>
{{/if}}