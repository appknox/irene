<AkStack @direction='column' @width='full' local-class='panel-group'>
  <Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel
    @panelId={{@panelId}}
    @title={{t 'securityAnalysisDetails.validatedFindings.aeisConfiguration'}}
    @iconName='settings'
    @iconColor='warn'
    @disabled={{@disabled}}
    @isExpanded={{@isExpanded}}
    @onToggle={{@onTogglePanel}}
    @onSave={{@onSavePanel}}
  >
    <AkStack
      @justifyContent='space-between'
      @alignItems='center'
      @width='full'
      @spacing='3.5'
    >
      <AkStack
        @direction='column'
        @width='6/12'
        @alignItems='center'
        @justifyContent='center'
        @spacing='1.5'
      >
        <Security::AnalysisDetails::ScoreChip
          @score={{this.displayScore}}
          @label={{this.scoreLabel}}
          @riskClass={{this.scoreRiskClass}}
          @testId='validatedFinding'
        />

        <Security::AnalysisDetails::ValidatedFindings::ScoreField
          @score={{this.finding.exploitabilityScore}}
          @disabled={{@disabled}}
          @onChange={{this.updateScore}}
        />

        <AkDivider @color='dark' @width='200px' />

        <AkStack @direction='column' @alignItems='center' @spacing='0.5'>
          <AkTypography @variant='body3' @color='textSecondary'>
            {{t 'securityAnalysisDetails.validatedFindings.likelihood'}}
          </AkTypography>

          <AkSelect
            @selected={{this.finding.exploitabilityLikelihood}}
            @options={{this.likelihoodOptions}}
            @onChange={{this.selectLikelihood}}
            @disabled={{@disabled}}
            @placeholder={{t
              'securityAnalysisDetails.validatedFindings.selectLikelihood'
            }}
            local-class='signal-select'
            data-test-securityAnalysisDetails-validatedFindings-likelihoodSelect
            as |likelihood|
          >
            {{this.scaleLabel likelihood}}
          </AkSelect>
        </AkStack>
      </AkStack>

      <AkStack @direction='column' @spacing='2.5' @width='6/12'>
        {{#each this.signalRows as |row|}}
          <AkStack
            @spacing='2.5'
            @width='full'
            @justifyContent='space-between'
            @alignItems='center'
          >
            <AkTypography
              @variant='body2'
              data-test-securityAnalysisDetails-validatedFindings-signalLabel='{{row.key}}'
            >
              {{row.label}}
            </AkTypography>

            <AkSelect
              @selected={{row.selected}}
              @options={{this.signalValues}}
              @onChange={{fn this.selectSignal row.key}}
              @disabled={{@disabled}}
              local-class='signal-select'
              data-test-securityAnalysisDetails-validatedFindings-signalSelect='{{row.key}}'
              as |value|
            >
              {{this.signalOptionLabel value}}
            </AkSelect>
          </AkStack>
        {{/each}}
      </AkStack>
    </AkStack>
  </Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel>
</AkStack>
