<AkStack
  @direction='column'
  @width='full'
  @spacing='2.5'
  data-test-securityAnalysisDetails-validatedFindings-detail
>
  <AkStack
    @direction='column'
    @width='full'
    local-class='panel-group aeis-group'
  >
    <Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel
      @panelId={{this.panel.AEIS}}
      @title={{t 'securityAnalysisDetails.validatedFindings.aeisConfiguration'}}
      @iconName='settings'
      @iconColor='warn'
      @disabled={{@disabled}}
      @isExpanded={{@isPanelOpen this.panel.AEIS}}
      @onToggle={{@onTogglePanel}}
      @onSave={{@onSavePanel}}
    >
      <AkStack
        @justifyContent='space-between'
        @alignItems='center'
        @width='full'
        @spacing='3.5'
      >
        <AkStack
          @direction='column'
          @width='6/12'
          @alignItems='center'
          @justifyContent='center'
          @spacing='1.5'
        >
          <Security::AnalysisDetails::ScoreChip
            @score={{this.displayScore}}
            @label={{this.scoreLabel}}
            @riskClass={{this.scoreRiskClass}}
            @testId='validatedFinding'
          />

          <Security::AnalysisDetails::ValidatedFindings::ScoreField
            @score={{this.finding.exploitabilityScore}}
            @disabled={{@disabled}}
            @onChange={{this.updateScore}}
          />

          <AkDivider @color='dark' @width='200px' />

          <AkStack @direction='column' @alignItems='center' @spacing='0.5'>
            <AkTypography @variant='body3' @color='textSecondary'>
              {{t 'securityAnalysisDetails.validatedFindings.likelihood'}}
            </AkTypography>

            <AkSelect
              @selected={{this.finding.exploitabilityLikelihood}}
              @options={{this.likelihoodOptions}}
              @onChange={{this.selectLikelihood}}
              @disabled={{@disabled}}
              @placeholder={{t
                'securityAnalysisDetails.validatedFindings.selectLikelihood'
              }}
              local-class='signal-select'
              data-test-securityAnalysisDetails-validatedFindings-likelihoodSelect
              as |likelihood|
            >
              {{this.scaleLabel likelihood}}
            </AkSelect>
          </AkStack>
        </AkStack>

        <AkStack @direction='column' @spacing='2.5' @width='6/12'>
          {{#each this.signalRows as |row|}}
            <AkStack
              @spacing='2.5'
              @width='full'
              @justifyContent='space-between'
              @alignItems='center'
            >
              <AkTypography
                @variant='body2'
                data-test-securityAnalysisDetails-validatedFindings-signalLabel='{{row.key}}'
              >
                {{row.label}}
              </AkTypography>

              <AkSelect
                @selected={{row.selected}}
                @options={{this.signalValues}}
                @onChange={{fn this.selectSignal row.key}}
                @disabled={{@disabled}}
                local-class='signal-select'
                data-test-securityAnalysisDetails-validatedFindings-signalSelect='{{row.key}}'
                as |value|
              >
                {{this.signalOptionLabel value}}
              </AkSelect>
            </AkStack>
          {{/each}}
        </AkStack>
      </AkStack>
    </Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel>
  </AkStack>

  <AkDivider @color='dark' />

  <AkStack @direction='column' @width='full' @spacing='1'>
    <AkTypography @variant='body2' @fontWeight='medium'>
      {{t 'securityAnalysisDetails.validatedFindings.confidence'}}
    </AkTypography>

    <AkSelect
      @selected={{this.finding.confidence}}
      @options={{this.confidenceOptions}}
      @onChange={{this.selectConfidence}}
      @disabled={{@disabled}}
      @placeholder={{t
        'securityAnalysisDetails.validatedFindings.selectConfidence'
      }}
      class='w-full'
      data-test-securityAnalysisDetails-validatedFindings-confidenceSelect
      as |confidence|
    >
      {{this.scaleLabel confidence}}
    </AkSelect>
  </AkStack>

  <AkStack @direction='column' @width='full' @spacing='1'>
    <AkTypography @variant='body2' @fontWeight='medium'>
      {{t 'securityAnalysisDetails.validatedFindings.summary'}}
    </AkTypography>

    <Textarea
      @value={{this.finding.summary}}
      disabled={{@disabled}}
      rows='3'
      local-class='summary-input'
      aria-label={{t 'securityAnalysisDetails.validatedFindings.summary'}}
      {{on 'input' this.updateSummary}}
      data-test-securityAnalysisDetails-validatedFindings-summaryInput
    />
  </AkStack>

  <AkStack @direction='column' @width='full' @spacing='1'>
    <AkTypography @variant='body2' @fontWeight='medium'>
      {{t 'securityAnalysisDetails.validatedFindings.evidence'}}
    </AkTypography>

    <AkRichTextEditor
      @value={{this.evidenceHtml}}
      @disabled={{@disabled}}
      @onChange={{this.updateEvidence}}
      data-test-securityAnalysisDetails-validatedFindings-evidenceEditor
    />
  </AkStack>

  <AkStack @direction='column' @width='full' @spacing='1'>
    <AkTypography @variant='body2' @fontWeight='medium'>
      {{t 'securityAnalysisDetails.validatedFindings.reasoning'}}
    </AkTypography>

    <AkRichTextEditor
      @value={{this.reasoningHtml}}
      @disabled={{@disabled}}
      @onChange={{this.updateReasoning}}
      data-test-securityAnalysisDetails-validatedFindings-reasoningEditor
    />
  </AkStack>

  <AkStack @direction='column' @width='full' local-class='panel-group'>
    <Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel
      @panelId={{this.panel.REMEDIATION}}
      @title={{t 'securityAnalysisDetails.validatedFindings.remediation'}}
      @iconName='lightbulb'
      @iconColor='success'
      @disabled={{@disabled}}
      @isExpanded={{@isPanelOpen this.panel.REMEDIATION}}
      @onToggle={{@onTogglePanel}}
      @onSave={{@onSavePanel}}
    >
      <AkStack @direction='column' @width='full' @spacing='2.5'>
        <AkStack @direction='column' @width='full' @spacing='1'>
          <AkTypography @variant='body2' @fontWeight='medium'>
            {{t 'securityAnalysisDetails.validatedFindings.remediationPrompt'}}
          </AkTypography>

          <AkTypography @variant='body3' @color='textSecondary'>
            {{t
              'securityAnalysisDetails.validatedFindings.remediationPromptHint'
            }}
          </AkTypography>

          <Textarea
            @value={{this.remediationPrompt}}
            disabled={{@disabled}}
            rows='6'
            spellcheck='false'
            local-class='prompt-input'
            placeholder={{t
              'securityAnalysisDetails.validatedFindings.remediationPromptPlaceholder'
            }}
            aria-label={{t
              'securityAnalysisDetails.validatedFindings.remediationPrompt'
            }}
            {{on 'input' this.updateRemediationPrompt}}
            data-test-securityAnalysisDetails-validatedFindings-remediationPromptInput
          />
        </AkStack>

        <AkDivider @color='dark' local-class='panel-section-divider' />

        <AkStack @direction='column' @width='full' @spacing='1'>
          <AkTypography @variant='body2' @fontWeight='medium'>
            {{t 'securityAnalysisDetails.validatedFindings.remediationSteps'}}
          </AkTypography>

          <AkTypography @variant='body3' @color='textSecondary'>
            {{t
              'securityAnalysisDetails.validatedFindings.remediationStepsHint'
            }}
          </AkTypography>
        </AkStack>

        <Security::AnalysisDetails::ValidatedFindings::StepList
          @steps={{@remediationSteps}}
          @disabled={{@disabled}}
          @onStepsChange={{@onRemediationStepsChange}}
          @addLabel={{t
            'securityAnalysisDetails.validatedFindings.addRemediationStep'
          }}
          @bodyPlaceholder={{t
            'securityAnalysisDetails.validatedFindings.addRemediation'
          }}
        />
      </AkStack>
    </Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel>

    <Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel
      @panelId={{this.panel.STEPS_TO_REPRODUCE}}
      @title={{t 'securityAnalysisDetails.validatedFindings.stepsToReproduce'}}
      @iconName='experiment'
      @iconColor='warn'
      @disabled={{@disabled}}
      @isExpanded={{@isPanelOpen this.panel.STEPS_TO_REPRODUCE}}
      @onToggle={{@onTogglePanel}}
      @onSave={{@onSavePanel}}
    >
      <Security::AnalysisDetails::ValidatedFindings::StepList
        @steps={{@stepsToReproduce}}
        @disabled={{@disabled}}
        @addLabel={{t
          'securityAnalysisDetails.validatedFindings.addReproductionStep'
        }}
        @bodyPlaceholder={{t
          'securityAnalysisDetails.validatedFindings.addStepsToReproduce'
        }}
        @onStepsChange={{@onReproductionStepsChange}}
      />
    </Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel>

    <Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel
      @panelId={{this.panel.EXPLOITABILITY}}
      @title={{t
        'securityAnalysisDetails.validatedFindings.exploitabilityAnalysis'
      }}
      @iconName='bug-report'
      @iconColor='error'
      @disabled={{@disabled}}
      @isExpanded={{@isPanelOpen this.panel.EXPLOITABILITY}}
      @onToggle={{@onTogglePanel}}
      @onSave={{@onSavePanel}}
    >
      <AkStack @direction='column' @width='full' @spacing='1.5'>
        <AkRichTextEditor
          @value={{this.exploitabilityAnalysisHtml}}
          @disabled={{@disabled}}
          @onChange={{this.updateExploitabilityBody}}
          data-test-securityAnalysisDetails-validatedFindings-exploitabilityEditor
        />
      </AkStack>
    </Security::AnalysisDetails::ValidatedFindings::FindingDetail::Panel>

    <button
      type='button'
      local-class='expand-all-action'
      {{on 'click' @onToggleExpandAll}}
      data-test-securityAnalysisDetails-validatedFindings-expandAllBtn
    >
      <AkIcon
        @iconName={{if @areAllPanelsOpen 'arrow-drop-up' 'arrow-drop-down'}}
        @size='small'
        @color='primary'
      />

      <AkTypography @variant='subtitle2' @color='primary'>
        {{#if @areAllPanelsOpen}}
          {{t 'securityAnalysisDetails.validatedFindings.collapseAll'}}
        {{else}}
          {{t 'securityAnalysisDetails.validatedFindings.expandAll'}}
        {{/if}}
      </AkTypography>
    </button>
  </AkStack>

</AkStack>