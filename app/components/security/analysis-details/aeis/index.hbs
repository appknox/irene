<Security::AnalysisDetails::SectionCard
  @title={{t 'securityAnalysisDetails.aeis.title'}}
  @testId='aeis'
>
  <:actions>
    <AkButton
      @disabled={{this.isSaving}}
      {{on 'click' this.resetSignals}}
      data-test-securityAnalysisDetails-aeis-resetBtn
    >
      <:leftIcon>
        <AkIcon @iconName='close' />
      </:leftIcon>

      <:default>
        {{t 'securityAnalysisDetails.aeis.reset'}}
      </:default>
    </AkButton>
  </:actions>

  <:content>
    <AkStack
      @justifyContent='space-between'
      @alignItems='center'
      @width='full'
      @spacing='3.5'
    >
      <AkStack
        @direction='column'
        @width='6/12'
        @alignItems='center'
        @justifyContent='center'
        @spacing='2'
      >
        <Security::AnalysisDetails::ScoreChip
          @score={{this.displayScore}}
          @label={{this.scoreLabel}}
          @riskClass={{this.scoreRiskClass}}
          @isLoading={{this.isSaving}}
          @testId='aeis'
        />

        <AkStack
          @alignItems='center'
          @spacing='1'
          local-class='score-stepper'
          data-test-securityAnalysisDetails-aeis-scoreStepper
        >
          <AkIconButton
            @size='small'
            @variant='outlined'
            disabled={{this.isDecrementDisabled}}
            aria-label={{t 'securityAnalysisDetails.aeis.decreaseScore'}}
            {{on 'click' (fn this.stepScore this.scoreStepDown)}}
            data-test-securityAnalysisDetails-aeis-scoreDecrementBtn
          >
            <AkIcon @iconName='remove' @size='small' />
          </AkIconButton>

          <Input
            @type='number'
            @value={{this.scoreFieldValue}}
            min={{this.scoreMin}}
            max={{this.scoreMax}}
            step={{this.scoreStepUp}}
            local-class='score-input'
            aria-label={{t 'securityAnalysisDetails.aeis.scoreField'}}
            {{on 'input' this.updateScore}}
            {{on 'blur' this.commitScore}}
            data-test-securityAnalysisDetails-aeis-scoreInput
          />

          <AkIconButton
            @size='small'
            @variant='outlined'
            disabled={{this.isIncrementDisabled}}
            aria-label={{t 'securityAnalysisDetails.aeis.increaseScore'}}
            {{on 'click' (fn this.stepScore this.scoreStepUp)}}
            data-test-securityAnalysisDetails-aeis-scoreIncrementBtn
          >
            <AkIcon @iconName='add' @size='small' />
          </AkIconButton>
        </AkStack>

        {{#if this.isUntested}}
          <AkTypography
            @variant='body3'
            @color='textSecondary'
            data-test-securityAnalysisDetails-aeis-noScore
          >
            {{t 'securityAnalysisDetails.aeis.noScoreYet'}}
          </AkTypography>
        {{/if}}

        <AkDivider
          @color='dark'
          @width='250px'
          data-test-securityAnalysisDetails-aeis-likelihoodDivider
        />

        <AkStack
          @direction='column'
          @alignItems='center'
          @spacing='0.5'
          local-class='likelihood-field'
        >
          <AkTypography
            local-class='likelihood-label'
            data-test-securityAnalysisDetails-aeis-likelihoodLabel
          >
            {{t 'securityAnalysisDetails.aeis.likelihoodLabel'}}
          </AkTypography>

          <AkSelect
            @selected={{this.selectedLikelihood}}
            @options={{this.likelihoodOptions}}
            @onChange={{this.selectLikelihood}}
            @placeholder={{t 'securityAnalysisDetails.aeis.likelihoodLabel'}}
            local-class='signal-select'
            data-test-securityAnalysisDetails-aeis-likelihoodSelect
            as |value|
          >
            {{this.likelihoodOptionLabel value}}
          </AkSelect>
        </AkStack>
      </AkStack>

      <AkStack @direction='column' @spacing='2.5' @width='6/12'>
        {{#each this.signalRows as |row|}}
          <AkStack
            @spacing='3.5'
            @width='full'
            @justifyContent='space-between'
            @alignItems='center'
          >
            <AkTypography
              local-class='signal-label'
              data-test-securityAnalysisDetails-aeis-signalLabel='{{row.key}}'
            >
              {{row.label}}
            </AkTypography>

            <AkSelect
              @selected={{row.selected}}
              @options={{this.signalValues}}
              @onChange={{fn this.selectSignal row.key}}
              local-class='signal-select'
              data-test-securityAnalysisDetails-aeis-signalSelect='{{row.key}}'
              as |value|
            >
              {{this.signalOptionLabel value}}
            </AkSelect>
          </AkStack>
        {{/each}}
      </AkStack>
    </AkStack>
  </:content>
</Security::AnalysisDetails::SectionCard>
