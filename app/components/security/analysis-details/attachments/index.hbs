<Security::AnalysisDetails::SectionCard
  @title={{t 'securityAnalysisDetails.attachments.title'}}
  @description={{t 'securityAnalysisDetails.attachments.description'}}
  @testId='attachments'
>
  <:content>
    <AkStack @direction='column' @width='full' @spacing='2'>
      <Security::AnalysisDetails::Attachments::Dropzone
        @isUploading={{this.isUploading}}
        @onFileAdded={{this.triggerFileUpload}}
      />

      {{#if this.hasAttachments}}
        <AkStack
          @alignItems='center'
          @spacing='1'
          @flexWrap='wrap'
          @width='full'
          data-test-securityAnalysisDetails-attachments-list
        >
          {{#if this.uploadingFile}}
            <Security::AnalysisDetails::Attachments::FileChip
              @name={{this.uploadingFile.name}}
              @extension={{file-extension this.uploadingFile.name}}
              @isUploading={{true}}
              @removeDisabled={{true}}
              @onView={{this.closePreview}}
              @onRemove={{this.closePreview}}
              data-test-securityAnalysisDetails-attachments-uploadingFile
            />
          {{/if}}

          {{#each this.analysis.attachments as |attachment|}}
            <Security::AnalysisDetails::Attachments::FileChip
              @name={{attachment.name}}
              @extension={{file-extension attachment.name}}
              @removeDisabled={{and
                this.deleteFile.isRunning
                (eq this.fileIDToDelete attachment.id)
              }}
              @onView={{fn
                this.triggerPreviewAttachment
                attachment.id
                attachment.name
              }}
              @onDownload={{fn this.triggerDownloadAttachment attachment.id}}
              @onRemove={{fn this.openRemoveFileConfirmBox attachment.id}}
              data-test-securityAnalysisDetails-attachments-uploadedFile='{{attachment.id}}'
            />
          {{/each}}
        </AkStack>

      {{else}}
        <AkTypography
          @color='textSecondary'
          @variant='body2'
          @fontWeight='light'
          data-test-securityAnalysisDetails-attachments-emptyUploadMessage
        >
          {{t 'securityAnalysisDetails.attachments.noFiles'}}
        </AkTypography>
      {{/if}}
    </AkStack>
  </:content>
</Security::AnalysisDetails::SectionCard>

<ConfirmBox
  @isActive={{this.showRemoveFileConfirmBox}}
  @title={{t 'securityAnalysisDetails.attachments.removeFileConfirm'}}
  @confirmAction={{this.confirmFileDeleteAction}}
  @cancelAction={{this.closeRemoveFileConfirmBox}}
/>

{{#if this.previewUrl}}
  <Security::AnalysisDetails::Attachments::PreviewModal
    @name={{this.previewName}}
    @url={{this.previewUrl}}
    @onClose={{this.closePreview}}
    @onOpenInNewTab={{this.openPreviewInNewTab}}
  />
{{/if}}
