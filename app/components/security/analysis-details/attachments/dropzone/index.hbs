{{#let
  (file-queue name='analysisAttachmentFileUpload' onFileAdded=@onFileAdded)
  as |queue|
}}
  <FileDropzone
    @queue={{queue}}
    local-class='dropzone'
    data-test-attachmentDropzone
    as |dropzone|
  >
    <AkStack
      @tag='label'
      @direction='column'
      @alignItems='center'
      @width='full'
      @spacing='2'
      local-class='dropzone-inner
        {{if dropzone.active "is-active"}}
        {{if @isUploading "is-disabled"}}'
      data-test-attachmentDropzone-label
    >
      <span local-class='upload-pill'>
        {{#if @isUploading}}
          <AkLoader @size={{14}} />
        {{else}}
          <AkIcon @iconName='file-upload' @size='small' />
        {{/if}}

        <AkTypography @tag='span' @color='inherit' @fontWeight='bold'>
          {{#if @isUploading}}
            {{t 'uploading'}}...
          {{else}}
            {{t 'securityAnalysisDetails.attachments.upload'}}
          {{/if}}
        </AkTypography>
      </span>

      <AkStack
        @tag='span'
        @direction='column'
        @alignItems='center'
        @spacing='1/2'
      >
        <AkTypography
          @tag='span'
          @fontWeight='bold'
          local-class='dropzone-title'
        >
          {{t 'securityAnalysisDetails.attachments.dropzoneLabel'}}
        </AkTypography>

        <AkTypography @tag='span' local-class='dropzone-hint'>
          {{t 'securityAnalysisDetails.attachments.maxFileSize'}}
        </AkTypography>
      </AkStack>

      <input
        type='file'
        disabled={{@isUploading}}
        id='upload-analysis-details-file-input'
        {{style display='none'}}
        {{queue.selectFile}}
        data-test-attachmentDropzone-input
      />
    </AkStack>
  </FileDropzone>
{{/let}}