<Textarea
  @value={{@finding.title}}
  autocomplete='off'
  autocorrect='off'
  autocapitalize='off'
  spellcheck='false'
  rows='3'
  placeholder={{t 'title'}}
  local-class='textarea-input'
  aria-label='finding title'
  {{on 'input' @onFindingEdited}}
  data-test-securityAnalysisDetails-findingTitle
/>