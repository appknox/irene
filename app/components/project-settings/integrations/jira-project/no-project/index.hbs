{{#if @jiraSecurityConnected}}
  <AkStack
    @direction='column'
    @spacing='2'
    @alignItems='center'
    @justifyContent='center'
  >
    <AkSvg::PlugConnector />

    <AkTypography
      @color='textSecondary'
      @variant='body2'
      data-test-prjSettings-integrations-jiraProject-jiraSecurityNote
    >
      {{t 'jiraSecurityProjectNote'}}
    </AkTypography>
  </AkStack>

{{else}}
  <AkTypography
    @color='textSecondary'
    @variant='body2'
    data-test-prjSettings-integrations-jiraProject-noProject
  >
    {{#if @reconnect}}
      {{t 'jira'}}
      {{t 'reconnectGotoSettings'}}
    {{else}}
      {{t 'jiraNoProject'}}
    {{/if}}

    <AkLink
      @typographyVariant='body2'
      @route='authenticated.dashboard.organization-settings.integrations'
      @color='primary'
      @underline='always'
      data-test-prjSettings-integrations-jiraProject-noProject-integrationLink
    >
      {{t 'clickingHere'}}
    </AkLink>
  </AkTypography>
{{/if}}