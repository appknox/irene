{{#if @scan.isFailed}}
  <div
    local-class='chip-container failed-chip'
    data-test-offensiveSecurity-statusChip-failed
    ...attributes
  >
    <AkIcon
      local-class='chip-icon failed-chip-icon'
      @iconName='error'
      @size='small'
    />

    <span>{{t 'offensiveSecurity.status.failed'}}</span>
  </div>
{{else if @scan.isCompleted}}
  <div
    local-class='chip-container completed-chip'
    data-test-offensiveSecurity-statusChip-completed
    ...attributes
  >
    <AkIcon
      local-class='chip-icon completed-chip-icon'
      @iconName='check-circle'
      @size='small'
    />

    <span>{{t 'offensiveSecurity.status.completed'}}</span>
  </div>
{{else if @scan.isNotStarted}}
  <div
    local-class='chip-container pending-chip'
    data-test-offensiveSecurity-statusChip-pending
    ...attributes
  >
    <span>{{t 'offensiveSecurity.status.notStarted'}}</span>
  </div>
{{else if @scan.isQueued}}
  <div
    local-class='chip-container running-chip'
    data-test-offensiveSecurity-statusChip-queued
    ...attributes
  >
    <AkLoader
      @size={{13}}
      @thickness={{6}}
      @color='info'
      local-class='running-loader'
    />

    <span>{{t 'offensiveSecurity.status.queued'}}</span>
  </div>
{{else}}
  <div
    local-class='chip-container running-chip'
    data-test-offensiveSecurity-statusChip-running
    ...attributes
  >
    <AkLoader
      @size={{13}}
      @thickness={{6}}
      @color='info'
      local-class='running-loader'
    />

    <span>{{t 'offensiveSecurity.status.running'}}</span>
  </div>
{{/if}}