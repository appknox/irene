<section local-class='summary-card' data-test-offensiveSecurity-summaryCard>
  <div local-class='summary-header'>
    <div local-class='summary-title-group'>
      <h3
        local-class='summary-title'
        data-test-offensiveSecurity-summaryCard-title
      >
        {{t 'offensiveSecurity.scanSummary'}}
      </h3>

      {{#if @scan.isRunning}}
        <span
          local-class='live-indicator'
          data-test-offensiveSecurity-summaryCard-live
        >
          <span local-class='live-dot'></span>
          {{t 'offensiveSecurity.live'}}
        </span>
      {{/if}}
    </div>

    <div local-class='summary-actions'>
      {{#if @scan.isCompleted}}
        <button
          type='button'
          local-class='summary-btn summary-btn-secondary'
          {{on 'click' this.openArtifacts}}
          data-test-offensiveSecurity-summaryCard-artifactsBtn
        >
          <AkIcon @iconName='description' local-class='summary-btn-icon' />
          <span>
            {{t 'offensiveSecurity.artifactsCount' count=this.artifactsCount}}
          </span>
        </button>
      {{/if}}

      <button
        type='button'
        local-class='summary-btn summary-btn-primary'
        {{on 'click' @onViewResults}}
        data-test-offensiveSecurity-scanResults-viewResultsBtn
      >
        <span>{{t 'offensiveSecurity.viewResults'}}</span>
        <AkIcon @iconName='arrow-forward' local-class='summary-btn-icon' />
      </button>
    </div>
  </div>

  <dl local-class='stats-grid'>
    {{#each this.stats as |stat|}}
      <div
        local-class='stat-tile {{stat.tone}}'
        data-test-offensiveSecurity-summaryCard-stat
      >
        <dt local-class='stat-label'>{{stat.label}}</dt>
        <dd local-class='stat-value'>{{stat.value}}</dd>
      </div>
    {{/each}}
  </dl>
</section>

<AkDrawer
  @open={{this.isArtifactsOpen}}
  @onClose={{this.closeArtifacts}}
  @anchor='right'
>
  <div
    local-class='artifacts-drawer'
    data-test-offensiveSecurity-summaryCard-artifactsDrawer
  >
    <div local-class='drawer-header'>
      <h3 local-class='drawer-title'>{{t 'offensiveSecurity.artifacts'}}</h3>

      <AkIconButton
        aria-label={{t 'close'}}
        {{on 'click' this.closeArtifacts}}
        data-test-offensiveSecurity-summaryCard-artifactsClose
      >
        <AkIcon @iconName='close' />
      </AkIconButton>
    </div>

    <p class='offsec-prose' local-class='drawer-subtitle'>
      {{t 'offensiveSecurity.artifactsDrawerSubtitle' app=@scan.displayName}}
    </p>

    <OffensiveSecurity::ScanResults::ArtifactsCard
      @scan={{@scan}}
      @artifacts={{@artifacts}}
      @onDownload={{@onDownload}}
      @isDownloading={{@isDownloading}}
      @isInDrawer={{true}}
    />
  </div>
</AkDrawer>