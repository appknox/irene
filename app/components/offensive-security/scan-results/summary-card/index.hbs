<section local-class='summary-card' data-test-offensiveSecurity-summaryCard>
  <div local-class='summary-header'>
    <AkTypography
      @variant='subtitle2'
      @fontWeight='bold'
      data-test-offensiveSecurity-summaryCard-title
    >
      {{t 'offensiveSecurity.scanSummary'}}
    </AkTypography>

    <button
      type='button'
      local-class='artifacts-link'
      {{on 'click' this.openArtifacts}}
      data-test-offensiveSecurity-summaryCard-artifactsBtn
    >
      <AkIcon @iconName='description' @size='small' />
      <span>
        {{t 'offensiveSecurity.artifactsCount' count=this.artifactsCount}}
      </span>
      <AkIcon @iconName='chevron-right' @size='small' />
    </button>
  </div>

  <dl local-class='stats-grid'>
    <div local-class='stat-tile'>
      <dt local-class='stat-label'>{{t 'offensiveSecurity.riskRating'}}</dt>
      <dd local-class='stat-value'>
        <span
          local-class='risk-badge risk-{{@scan.riskClass}}'
          data-test-offensiveSecurity-summaryCard-risk
        >
          {{t (concat 'offensiveSecurity.riskLevel.' @scan.riskClass)}}
        </span>
      </dd>
    </div>

    {{#each this.stats as |stat|}}
      <div
        local-class='stat-tile {{stat.tone}}'
        data-test-offensiveSecurity-summaryCard-stat
      >
        <dt local-class='stat-label'>{{stat.label}}</dt>
        <dd local-class='stat-value stat-number'>{{stat.value}}</dd>
      </div>
    {{/each}}

    {{#if this.showResilience}}
      <div
        local-class='stat-tile'
        data-test-offensiveSecurity-summaryCard-resilience
      >
        <dt local-class='stat-label'>
          {{t 'offensiveSecurity.overallResilience'}}
        </dt>
        <dd local-class='stat-value stat-number'>
          {{this.effectiveResilience}}

          {{#if this.resilienceBandLabel}}
            <span local-class='stat-suffix'>({{this.resilienceBandLabel}})</span>
          {{/if}}
        </dd>
      </div>
    {{/if}}
  </dl>
</section>

<AkDrawer
  @open={{this.isArtifactsOpen}}
  @onClose={{this.closeArtifacts}}
  @anchor='right'
>
  <div
    local-class='artifacts-drawer'
    data-test-offensiveSecurity-summaryCard-artifactsDrawer
  >
    <div local-class='drawer-header'>
      <AkTypography @variant='h5' @fontWeight='bold'>
        {{t 'offensiveSecurity.artifacts'}}
      </AkTypography>

      <AkIconButton
        aria-label={{t 'close'}}
        {{on 'click' this.closeArtifacts}}
        data-test-offensiveSecurity-summaryCard-artifactsClose
      >
        <AkIcon @iconName='close' />
      </AkIconButton>
    </div>

    <AkTypography @variant='body2' @color='textSecondary' class='px-3 pt-2'>
      {{t
        'offensiveSecurity.artifactsDrawerSubtitle'
        app=@scan.displayName
      }}
    </AkTypography>

    <OffensiveSecurity::ScanResults::ArtifactsCard
      @scan={{@scan}}
      @artifacts={{@artifacts}}
      @onDownload={{@onDownload}}
      @isDownloading={{@isDownloading}}
      @isInDrawer={{true}}
    />
  </div>
</AkDrawer>
