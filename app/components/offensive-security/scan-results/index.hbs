<AkStack @direction='column' @spacing='3' class='p-3'>
  {{#if this.isLoading}}
    <AkBreadcrumbs::AutoTrail class='mb-1' />
    <AkSkeleton @width='100%' @height='120px' />
    <AkSkeleton @width='100%' @height='320px' />

  {{else if this.activeGoal}}
    {{! Penetration Test Goal Detail Page }}
    <OffensiveSecurity::ScanResults::PentestResults
      @scan={{this.scan}}
      @goals={{this.pentestGoals}}
      @initialGoalIndex={{this.activeGoalIndex}}
      @onBack={{this.closeGoal}}
      @onGoalChange={{this.handleGoalChange}}
    />

  {{else if this.scan}}
    <AkBreadcrumbs::AutoTrail class='mb-1' />

    {{! Target header banner matching existing dashboard file details summary }}
    <div
      local-class='file-summary-root'
      data-test-offensiveSecurity-scanResults-header
    >
      <AkStack
        class='p-2'
        local-class='file-summary-header'
        @alignItems='center'
        @justifyContent='space-between'
      >
        <AkStack @alignItems='center' @spacing='1.5'>
          <AppLogo
            @src={{this.scan.appIconUrl}}
            @size='large'
            @alt={{concat this.scan.displayName ' - logo'}}
            @fallbackName={{this.scan.displayName}}
          />

          <AkStack @direction='column' @spacing='0.5'>
            <AkTypography @variant='subtitle1' @fontWeight='bold'>
              {{this.scan.displayName}}
            </AkTypography>

            <AkTypography @color='textSecondary' class='font-mono'>
              {{this.scan.packageName}}
            </AkTypography>
          </AkStack>
        </AkStack>

        <AkStack @alignItems='center' @spacing='1'>
          {{#unless this.scan.isStaticScanStartedValue}}
            <div>
              <AkButton
                @variant='filled'
                @color='primary'
                @loading={{this.initiateStaticScanTask.isRunning}}
                {{on 'click' this.handleInitiateStaticScan}}
                data-test-offensiveSecurity-scanResults-initiateStaticScanBtn
              >
                Initiate static scan
              </AkButton>
            </div>
          {{/unless}}
        </AkStack>
      </AkStack>

      <AkDivider @color='dark' />

      <div class='px-2'>
        <AkStack
          local-class='file-summary-padding'
          @alignItems='center'
          @justifyContent='space-between'
        >
          <AkStack @alignItems='center'>
            <AkIconButton
              @size='small'
              {{on 'click' this.toggleFileDetails}}
              data-test-offensiveSecurity-scanResults-accordionToggle
            >
              <AkIcon
                @iconName={{if
                  this.isFileDetailsExpanded
                  'arrow-drop-up'
                  'arrow-drop-down'
                }}
                local-class='show-more-icon'
              />
            </AkIconButton>

            <AkTypography @variant='subtitle1'>
              {{t 'targetID'}}
              -
              <strong>{{this.displayTargetId}}</strong>
            </AkTypography>
          </AkStack>

          <AppPlatformIcon @platform={{this.scan.platformIcon}} />
        </AkStack>

        {{#if this.isFileDetailsExpanded}}
          <AkDivider />

          <AkStack local-class='file-summary-padding'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              Version
            </AkTypography>

            <AkTypography @variant='h6'>
              {{if this.scan.version this.scan.version '—'}}
            </AkTypography>
          </AkStack>

          <AkDivider />

          <AkStack local-class='file-summary-padding'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              Version code
            </AkTypography>

            <AkTypography @variant='h6'>
              {{if this.scan.versionCode this.scan.versionCode '—'}}
            </AkTypography>
          </AkStack>

          <AkDivider />

          <AkStack local-class='file-summary-padding'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              Uploaded on
            </AkTypography>

            <AkTypography @variant='h6'>
              {{if
                this.scan.formattedUploadedOn
                this.scan.formattedUploadedOn
                '—'
              }}
            </AkTypography>
          </AkStack>

          <AkDivider />

          <AkStack local-class='file-summary-padding'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              SHA1 hash
            </AkTypography>

            <AkTypography @variant='h6'>
              {{if this.scan.sha1Value this.scan.sha1Value '—'}}
            </AkTypography>
          </AkStack>

          <AkDivider />

          <AkStack local-class='file-summary-padding'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              MD5 hash
            </AkTypography>

            <AkTypography @variant='h6'>
              {{if this.scan.md5Value this.scan.md5Value '—'}}
            </AkTypography>
          </AkStack>

          <AkDivider />

          <AkStack local-class='file-summary-padding' @alignItems='center'>
            <AkTypography {{style width='190px'}} @color='textSecondary'>
              Development framework
            </AkTypography>

            <AkStack @alignItems='center' @spacing='1'>
              <PlatformIcon @code={{this.scan.devFrameworkCode}} @size='18px' />

              <AkTypography @variant='h6'>
                {{this.scan.devFrameworkLabel}}
              </AkTypography>
            </AkStack>
          </AkStack>

          <AkDivider />
        {{/if}}
      </div>
    </div>

    {{#if this.scan.isFailed}}
      <AkStack
        @width='full'
        @alignItems='center'
        @spacing='1'
        local-class='failure-banner'
        class='p-2'
        data-test-offensiveSecurity-scanResults-failureBanner
      >
        <AkIcon @iconName='error' @size='small' @color='error' />

        <AkTypography @variant='body2' @color='inherit'>
          {{this.formattedStatusReason}}
        </AkTypography>
      </AkStack>
    {{/if}}

    {{! Unified Offensive Security Run Card }}
    <div local-class='run-card'>
      <div local-class='run-card-header'>
        <AkTypography @variant='body1' @fontWeight='bold'>
          {{t 'offensiveSecurity.attackRun'}}
        </AkTypography>

        <div local-class='run-card-header-actions'>
          {{#if (and this.shouldShowDeviceCard this.isDevicePanelCollapsed)}}
            <button
              type='button'
              local-class='show-device-btn'
              {{on 'click' this.toggleDevicePanel}}
              data-test-offensiveSecurity-showDeviceBtn
            >
              <AkIcon @iconName='mobile' @size='small' />
              <span>{{t 'offensiveSecurity.showDevicePreview'}}</span>
            </button>
          {{/if}}

          <OffensiveSecurity::StatusChip @scan={{this.scan}} />
        </div>
      </div>

      <div
        local-class='run-split {{if
          (or (not this.shouldShowDeviceCard) this.isDevicePanelCollapsed)
          "is-collapsed"
        }}'
      >
        <div local-class='run-logs-col'>
          <OffensiveSecurity::ScanResults::AgentLog
            @scan={{this.scan}}
            @lines={{this.logLines}}
            @loadFailed={{this.logLoadFailed}}
            @isLoading={{this.loadLog.isRunning}}
            @isEmbedded={{true}}
          />
        </div>

        {{#if
          (and this.shouldShowDeviceCard (not this.isDevicePanelCollapsed))
        }}
          <div
            local-class='run-device-col'
            data-test-offensiveSecurity-deviceCard
          >
            {{#if this.isDeviceExpanded}}
              <button
                type='button'
                local-class='device-modal-backdrop'
                aria-label='Close device preview'
                {{on 'click' this.toggleDeviceExpand}}
                data-test-offensiveSecurity-deviceModal-backdrop
              />
            {{/if}}

            <div
              local-class='device-panel {{if
                this.isDeviceExpanded
                "is-expanded"
              }}'
            >
              <div local-class='device-panel-header'>
                <div local-class='device-title-group'>
                  <AkTypography @variant='body2' @fontWeight='bold'>
                    {{t 'realDevice'}}
                  </AkTypography>

                  <span local-class='title-divider'>|</span>

                  {{#if this.isDeviceActive}}
                    <span
                      local-class='live-badge'
                      data-test-offensiveSecurity-deviceLiveBadge
                    >
                      <span local-class='live-dot'></span>
                      LIVE · Connected
                    </span>
                  {{else}}
                    <span local-class='device-idle-status'>
                      <span local-class='idle-dot'></span>
                      {{if
                        this.scan.isRunning
                        (t 'offensiveSecurity.waitingForDevice')
                        (t 'offensiveSecurity.noActiveDevice')
                      }}
                    </span>
                  {{/if}}
                </div>

                <AkIconButton
                  @size='small'
                  @variant='default'
                  aria-label={{if
                    this.isDeviceExpanded
                    'Collapse preview (Esc)'
                    (t 'offensiveSecurity.expandPreview')
                  }}
                  title={{if
                    this.isDeviceExpanded
                    'Collapse preview (Esc)'
                    (t 'offensiveSecurity.expandPreview')
                  }}
                  local-class='collapse-panel-btn'
                  {{on 'click' this.toggleDeviceExpand}}
                  data-test-offensiveSecurity-collapseDeviceBtn
                  data-test-offensiveSecurity-expandPreviewBtn
                >
                  {{#if this.isDeviceExpanded}}
                    <svg
                      viewBox='0 0 24 24'
                      width='15'
                      height='15'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                      local-class='expand-icon-svg'
                    >
                      <polyline points='4 8 8 8 8 4' />
                      <line x1='3' y1='3' x2='8' y2='8' />
                      <polyline points='20 8 16 8 16 4' />
                      <line x1='21' y1='3' x2='16' y2='8' />
                      <polyline points='20 16 16 16 16 20' />
                      <line x1='21' y1='21' x2='16' y2='16' />
                      <polyline points='4 16 8 16 8 20' />
                      <line x1='3' y1='21' x2='8' y2='16' />
                    </svg>
                  {{else}}
                    <svg
                      viewBox='0 0 24 24'
                      width='15'
                      height='15'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                      local-class='expand-icon-svg'
                    >
                      <polyline points='15 3 21 3 21 9' />
                      <line x1='21' y1='3' x2='14' y2='10' />
                      <polyline points='9 3 3 3 3 9' />
                      <line x1='3' y1='3' x2='10' y2='10' />
                      <polyline points='15 21 21 21 21 15' />
                      <line x1='21' y1='21' x2='14' y2='14' />
                      <polyline points='9 21 3 21 3 15' />
                      <line x1='3' y1='21' x2='10' y2='14' />
                    </svg>
                  {{/if}}
                </AkIconButton>
              </div>

              <div local-class='phone-frame-wrapper'>
                <div
                  local-class='phone-frame'
                  style={{this.phoneFrameStyle}}
                >
                  <div local-class='phone-speaker-slit'></div>

                  <div local-class='phone-screen'>
                    {{#if this.isDeviceActive}}
                      <div
                        local-class='device-screen-wrapper {{if
                          this.deviceAspectRatio
                          "is-fitted"
                        }}'
                        data-test-offensiveSecurity-deviceScreen
                        {{did-insert this.setupDeviceObserver}}
                        {{will-destroy this.teardownDeviceObserver}}
                      >
                        <NovncRfb
                          @deviceFarmURL={{this.deviceFarmURL}}
                          @deviceFarmPassword={{this.deviceFarmPassword}}
                          @allowInteraction={{false}}
                          @containCanvas={{true}}
                        />
                      </div>
                    {{else}}
                      <div
                        local-class='device-placeholder'
                        data-test-offensiveSecurity-devicePlaceholder
                      >
                        <AkIcon
                          @iconName='mobile'
                          local-class='device-placeholder-icon'
                        />

                        <span local-class='device-placeholder-text'>
                          {{if
                            this.scan.isRunning
                            (t 'offensiveSecurity.waitingForDevice')
                            'Live device preview'
                          }}
                        </span>
                      </div>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {{/if}}
      </div>
    </div>

    {{! Summary and Artifacts cards row }}
    <AkStack
      @width='full'
      @spacing='3'
      @alignItems='stretch'
      local-class='summary-artifacts-row'
    >
      <div local-class='summary-artifacts-col'>
        <OffensiveSecurity::ScanResults::SummaryCard @scan={{this.scan}} />
      </div>

      <div local-class='summary-artifacts-col'>
        <OffensiveSecurity::ScanResults::ArtifactsCard
          @scan={{this.scan}}
          @artifacts={{this.artifacts}}
          @onDownload={{perform this.downloadArtifact}}
          @isDownloading={{this.downloadArtifact.isRunning}}
        />
      </div>
    </AkStack>

    {{! Penetration Test Goals (shown on main page if pentest_result is present) }}
    {{#if this.hasPentestResult}}
      <OffensiveSecurity::ScanResults::PentestGoalsCard
        @scan={{this.scan}}
        @goals={{this.pentestGoals}}
        @onGoalClick={{this.openGoal}}
      />
    {{/if}}

    {{! Findings }}
    <OffensiveSecurity::ScanResults::FindingsList
      @scan={{this.scan}}
      @findings={{this.findings}}
      @onFindingClick={{this.handleFindingClick}}
    />
  {{/if}}
</AkStack>