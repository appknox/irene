<AkStack
  @direction='column'
  @spacing='2'
  local-class='log-card'
  class='p-3'
  data-test-offensiveSecurity-agentLog
>
  <AkStack @width='full' @justifyContent='space-between' @alignItems='center'>
    <AkTypography @variant='body1' @fontWeight='medium'>
      {{t 'offensiveSecurity.attackRun'}}
    </AkTypography>

    <OffensiveSecurity::StatusChip @scan={{@scan}} />
  </AkStack>

  {{#if this.showInProgress}}
    <AkStack
      @width='full'
      @direction='column'
      @alignItems='center'
      @justifyContent='center'
      @spacing='2'
      class='p-4'
      local-class='log-placeholder'
      data-test-offensiveSecurity-agentLog-inProgress
    >
      <AkLoader @size={{32}} />

      <AkTypography @variant='body2' @color='textSecondary'>
        {{t 'offensiveSecurity.runInProgress'}}
      </AkTypography>

      <AkTypography @variant='body3' @color='textSecondary'>
        {{t 'offensiveSecurity.runInProgressSubtitle'}}
      </AkTypography>
    </AkStack>
  {{else if @isLoading}}
    <AkSkeleton @width='100%' @height='320px' />
  {{else if this.showEmptyState}}
    <AkStack
      @width='full'
      @alignItems='center'
      @justifyContent='center'
      class='p-4'
      local-class='log-placeholder'
      data-test-offensiveSecurity-agentLog-empty
    >
      <AkTypography @variant='body2' @color='textSecondary'>
        {{if
          @loadFailed
          (t 'offensiveSecurity.logUnavailable')
          (t 'offensiveSecurity.noLogRecorded')
        }}
      </AkTypography>
    </AkStack>
  {{else}}
    <div local-class='log-pane' data-test-offensiveSecurity-agentLog-pane>
      {{#each this.styledLines as |line|}}
        <div local-class='log-line {{line.tone}}'>{{line.text}}</div>
      {{/each}}
    </div>
  {{/if}}
</AkStack>
