{{#if this.isExpanded}}
  <button
    type='button'
    local-class='log-backdrop'
    aria-label='Close expanded terminal'
    {{on 'click' this.toggleExpand}}
    data-test-offensiveSecurity-agentLog-backdrop
  />
{{/if}}

<AkStack
  @direction='column'
  @spacing='2'
  local-class='log-card {{if this.isExpanded "is-expanded"}} {{if
    @isEmbedded
    "is-embedded"
  }}'
  class='p-3'
  data-test-offensiveSecurity-agentLog
>
  <AkStack
    @width='full'
    @justifyContent='space-between'
    @alignItems='center'
    local-class='log-header'
  >
    <AkStack @alignItems='center' @spacing='1.5'>
      <AkTypography
        @variant='body1'
        @fontWeight='medium'
        local-class='log-title'
      >
        {{if
          @isEmbedded
          (t 'offensiveSecurity.liveLogs')
          (t 'offensiveSecurity.attackRun')
        }}
      </AkTypography>

      {{#if (and this.isExpanded (gt this.styledLines.length 0))}}
        <span local-class='line-count-badge'>
          {{this.styledLines.length}}
          lines
        </span>
      {{/if}}
    </AkStack>

    <AkStack @alignItems='center' @spacing='1'>
      {{#if (and @isEmbedded @scan.isRunning)}}
        <span
          local-class='streaming-badge'
          data-test-offensiveSecurity-streamingBadge
        >
          <span local-class='streaming-dot'></span>
          Streaming
        </span>
      {{else if (not @isEmbedded)}}
        <OffensiveSecurity::StatusChip @scan={{@scan}} />
      {{/if}}

      {{#if (gt this.styledLines.length 15)}}
        <AkIconButton
          @size='small'
          @variant='default'
          aria-label={{if this.isScrolledUp 'Jump to latest' 'Scroll to top'}}
          title={{if this.isScrolledUp 'Jump to latest' 'Scroll to top'}}
          local-class='scroll-nav-btn'
          {{on 'click' this.scrollNav}}
          data-test-offensiveSecurity-agentLog-scrollNav
        >
          <AkIcon
            @iconName={{if this.isScrolledUp 'arrow-downward' 'arrow-upward'}}
            @size='small'
          />
        </AkIconButton>
      {{/if}}

      <AkIconButton
        @size='small'
        @variant='default'
        aria-label={{if
          this.isExpanded
          (t 'offensiveSecurity.collapseTerminal')
          (t 'offensiveSecurity.expandTerminal')
        }}
        title={{if this.isExpanded 'Collapse terminal (Esc)' 'Expand terminal'}}
        local-class='expand-btn'
        {{on 'click' this.toggleExpand}}
        data-test-offensiveSecurity-agentLog-expandBtn
      >
        {{#if this.isExpanded}}
          <svg
            viewBox='0 0 24 24'
            width='15'
            height='15'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
            local-class='expand-icon-svg'
          >
            <polyline points='4 8 8 8 8 4' />
            <line x1='3' y1='3' x2='8' y2='8' />
            <polyline points='20 8 16 8 16 4' />
            <line x1='21' y1='3' x2='16' y2='8' />
            <polyline points='20 16 16 16 16 20' />
            <line x1='21' y1='21' x2='16' y2='16' />
            <polyline points='4 16 8 16 8 20' />
            <line x1='3' y1='21' x2='8' y2='16' />
          </svg>
        {{else}}
          <svg
            viewBox='0 0 24 24'
            width='15'
            height='15'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
            local-class='expand-icon-svg'
          >
            <polyline points='15 3 21 3 21 9' />
            <line x1='21' y1='3' x2='14' y2='10' />
            <polyline points='9 3 3 3 3 9' />
            <line x1='3' y1='3' x2='10' y2='10' />
            <polyline points='15 21 21 21 21 15' />
            <line x1='21' y1='21' x2='14' y2='14' />
            <polyline points='9 21 3 21 3 15' />
            <line x1='3' y1='21' x2='10' y2='14' />
          </svg>
        {{/if}}
      </AkIconButton>
    </AkStack>
  </AkStack>

  <div local-class='log-body-container'>
    {{#if this.showInProgress}}
      <div local-class='log-pane' data-test-offensiveSecurity-agentLog-pane>
        <div
          local-class='log-line dim'
        >{{this.statusMessage}}{{this.dotsText}}</div>
      </div>
    {{else if @isLoading}}
      <AkSkeleton @width='100%' @height={{if this.isExpanded '100%' '320px'}} />
    {{else if this.showEmptyState}}
      <div local-class='log-pane' data-test-offensiveSecurity-agentLog-pane>
        <div local-class='log-line dim'>
          {{if
            @loadFailed
            (t 'offensiveSecurity.logUnavailable')
            (t 'offensiveSecurity.noLogRecorded')
          }}
          {{#if (and @loadFailed @scan.cachedLogUrl)}}
            <div local-class='log-link-row'>
              <a
                href={{@scan.cachedLogUrl}}
                target='_blank'
                rel='noopener noreferrer'
                local-class='log-direct-link'
              >
                Open log file directly ↗
              </a>
            </div>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div
        local-class='log-pane'
        data-test-offensiveSecurity-agentLog-pane
        {{did-insert this.setupLogPane}}
        {{did-update this.handleLinesUpdated @lines @lines.length}}
        {{on 'scroll' this.handleScroll}}
      >
        {{#each this.styledLines as |line|}}
          <div local-class='log-line {{line.tone}}'>{{line.text}}</div>
        {{/each}}
      </div>
    {{/if}}
  </div>
</AkStack>