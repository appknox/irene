{{#if @paths.length}}
  <div local-class='attempts' data-test-offensiveSecurity-goalView-attempts>
    {{#unless @hideLabel}}
      <div local-class='attempts-label'>
        {{t 'offensiveSecurity.goalView.otherAttempts'}}
        <span local-class='attempts-count'>{{@paths.length}}</span>
      </div>
    {{/unless}}

    {{#each @paths as |path|}}
      <details
        local-class='attempt'
        data-test-offensiveSecurity-goalView-attempt
      >
        <summary local-class='attempt-summary'>
          <span
            local-class='attempt-title'
            data-test-offensiveSecurity-goalView-attempt-title
          >
            {{this.pathName path}}
          </span>

          <span
            local-class='attempt-status is-{{path.status}}'
            data-test-offensiveSecurity-goalView-attempt-status
          >
            {{this.statusLabel path.status}}
          </span>

          <AkIcon
            @iconName='chevron-right'
            @size='small'
            local-class='attempt-chevron'
          />
        </summary>

        <div local-class='attempt-body'>
          {{#if path.summary}}
            <p class='offsec-prose' local-class='attempt-text'>
              {{this.text path.summary}}
            </p>
          {{/if}}

          {{#if path.expected}}
            <div local-class='attempt-label'>
              {{t 'offensiveSecurity.goalView.expected'}}
            </div>
            <p
              class='offsec-prose'
              local-class='attempt-text'
              data-test-offensiveSecurity-goalView-attempt-expected
            >
              {{this.text path.expected}}
            </p>
          {{/if}}

          {{#if path.outcome}}
            <div local-class='attempt-label'>
              {{t 'offensiveSecurity.goalView.whatHappened'}}
            </div>
            <p
              class='offsec-prose'
              local-class='attempt-text attempt-outcome'
              data-test-offensiveSecurity-goalView-attempt-outcome
            >
              {{this.text path.outcome}}
            </p>
          {{/if}}

          <OffensiveSecurity::ScanResults::GoalVerdictView::Observations
            @ids={{path.observations}}
            @observations={{@observations}}
          />
        </div>
      </details>
    {{/each}}
  </div>
{{/if}}