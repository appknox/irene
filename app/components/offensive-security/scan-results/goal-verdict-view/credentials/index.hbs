{{#if this.groups.length}}
  <div
    local-class='credentials'
    data-test-offensiveSecurity-goalView-credentials
  >
    {{#each this.groups as |credential index|}}
      <div
        local-class='credential'
        data-test-offensiveSecurity-goalView-credential={{index}}
      >
        {{#if credential.quotes}}
          <KnoxIq::CodeBlock @compact={{true}} @code={{credential.quotes}} />
        {{/if}}

        {{#if credential.exploitability_because}}
          <div local-class='credential-field'>
            <div local-class='credential-label'>
              {{if
                @isSafe
                (t 'offensiveSecurity.goalView.checkFound')
                (t 'offensiveSecurity.goalView.whyExploitable')
              }}
            </div>
            <p
              class='offsec-prose'
              local-class='credential-text'
              data-test-offensiveSecurity-goalView-credential-exploitability
            >
              {{credential.exploitability_because}}
            </p>
          </div>
        {{/if}}

        {{#if (and credential.severity (not @isSafe))}}
          <div local-class='credential-field'>
            <div local-class='credential-label'>
              {{t 'offensiveSecurity.goalView.whySevere'}}
            </div>
            <p
              class='offsec-prose'
              local-class='credential-text'
              data-test-offensiveSecurity-goalView-credential-severity
            >
              {{credential.severity}}
            </p>
          </div>
        {{/if}}
      </div>
    {{/each}}
  </div>
{{else if @evidence}}
  <div local-class='credentials'>
    <KnoxIq::CodeBlock @compact={{true}} @code={{@evidence}} />
  </div>
{{/if}}