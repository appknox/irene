<section local-class='findings-card' data-test-offensiveSecurity-findingsList>
  <div local-class='findings-header'>
    <div>
      <AkTypography
        @variant='subtitle1'
        @fontWeight='bold'
        data-test-offensiveSecurity-findingsList-title
      >
        {{t 'offensiveSecurity.findings'}}
      </AkTypography>

      <AkTypography @variant='body2' @color='textSecondary'>
        {{t 'offensiveSecurity.findingsSubtitle'}}
      </AkTypography>
    </div>

    {{#if @scan.isInProgress}}
      <span
        local-class='updating-live'
        data-test-offensiveSecurity-findingsList-updatingLive
      >
        <AkIcon @iconName='autorenew' @size='small' local-class='spinner' />
        {{t 'offensiveSecurity.updatingLive'}}
      </span>
    {{/if}}
  </div>

  <div local-class='findings-grid findings-column-header'>
    <span>{{t 'offensiveSecurity.defensesAssessed'}}</span>
    <span>{{t 'offensiveSecurity.checksCount'}}</span>
    <span>{{t 'offensiveSecurity.outcomeHeader'}}</span>
    <span></span>
  </div>

  {{#if this.hasFindings}}
    <ul local-class='groups-list'>
      {{#each this.groupedFindings as |group|}}
        <li>
          <button
            type='button'
            local-class='findings-grid group-row'
            {{on 'click' (fn this.handleCategoryClick group)}}
            data-test-offensiveSecurity-findingsList-group={{group.key}}
            data-test-offensiveSecurity-findingsList-groupHeader={{group.key}}
          >
            <span local-class='group-title-cell'>
              <span local-class='group-icon-box'>
                <AkIcon @iconName='shield' @size='small' />
              </span>

              <span local-class='group-text'>
                <AkTypography
                  @fontWeight='bold'
                  data-test-offensiveSecurity-findingsList-groupTitle
                >
                  {{group.title}}
                </AkTypography>

                {{#if group.summary}}
                  <AkTypography
                    @variant='body3'
                    @color='textSecondary'
                    @noWrap={{true}}
                    title={{group.summary}}
                    data-test-offensiveSecurity-findingsList-groupSummary
                  >
                    {{group.summary}}
                  </AkTypography>
                {{/if}}
              </span>
            </span>

            <AkTypography
              @fontWeight='bold'
              data-test-offensiveSecurity-findingsList-groupCount
            >
              {{group.findings.length}}
            </AkTypography>

            <span
              local-class='outcome-badge {{this.outcomeClass group.status}}'
              data-test-offensiveSecurity-findingsList-groupOutcome={{group.status}}
            >
              {{t (concat 'offensiveSecurity.outcome.' group.status)}}
            </span>

            <AkIcon
              @iconName='chevron-right'
              @color='textSecondary'
              local-class='row-chevron'
              data-test-offensiveSecurity-findingsList-expandIcon
            />
          </button>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <AkTypography
      @variant='body2'
      @color='textSecondary'
      local-class='findings-empty'
      data-test-offensiveSecurity-findingsList-empty
    >
      {{if
        @scan.isInProgress
        (t 'offensiveSecurity.findingsRecording')
        (t 'offensiveSecurity.noFindings')
      }}
    </AkTypography>
  {{/if}}
</section>