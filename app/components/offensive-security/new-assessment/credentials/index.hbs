<form
  local-class='card'
  autocomplete='off'
  onsubmit='return false;'
  data-test-credentials-card
>
  <div local-class='card-header'>
    <AkStack @alignItems='center' @spacing='1.5'>
      <AkTypography @variant='subtitle1' @fontWeight='bold'>
        {{t 'offensiveSecurity.testCredentials'}}
      </AkTypography>

      <span local-class='optional-tag' data-test-credentials-optional-chip>
        {{t 'optional'}}
      </span>
    </AkStack>

    <AkTypography @variant='body2' @color='textSecondary'>
      {{t 'offensiveSecurity.testCredentialsSubtitle'}}
    </AkTypography>
  </div>

  <div local-class='card-body'>
    <div local-class='credentials-grid credentials-grid-header'>
      <AkTypography @variant='body3' @fontWeight='bold' @color='textSecondary'>
        {{t 'offensiveSecurity.roleLabel'}}
      </AkTypography>

      <AkTypography @variant='body3' @fontWeight='bold' @color='textSecondary'>
        {{t 'offensiveSecurity.usernameEmail'}}
      </AkTypography>

      <AkTypography @variant='body3' @fontWeight='bold' @color='textSecondary'>
        {{t 'offensiveSecurity.password'}}
      </AkTypography>

      <span></span>
    </div>

    <div local-class='credentials-rows'>
      {{#each this.credentials key='id' as |cred index|}}
        <div local-class='credentials-grid' data-test-credential-row={{index}}>
          <AkTextField
            @id='offsec-cred-role-{{cred.id}}'
            @type='text'
            @placeholder={{t 'offensiveSecurity.rolePlaceholder'}}
            @value={{cred.role}}
            name='offsec_role_{{cred.id}}'
            autocomplete='off'
            data-test-cred-role={{index}}
            {{on 'input' (fn this.updateCredential index 'role')}}
          />

          <AkTextField
            @id='offsec-cred-user-{{cred.id}}'
            @type='email'
            @placeholder={{t 'offensiveSecurity.usernamePlaceholder'}}
            @value={{cred.username}}
            name='offsec_user_{{cred.id}}'
            autocomplete='off'
            data-test-cred-username={{index}}
            {{on 'input' (fn this.updateCredential index 'username')}}
          />

          <AkTextField
            @id='offsec-cred-pwd-{{cred.id}}'
            @type={{if cred.showPassword 'text' 'password'}}
            @placeholder={{t 'offensiveSecurity.passwordPlaceholder'}}
            @value={{cred.password}}
            name='offsec_password_{{cred.id}}'
            autocomplete='new-password'
            data-test-cred-password={{index}}
            {{on 'input' (fn this.updateCredential index 'password')}}
          >
            <:rightAdornment>
              <AkIconButton
                @type='button'
                @size='small'
                aria-label={{if
                  cred.showPassword
                  (t 'offensiveSecurity.hide')
                  (t 'offensiveSecurity.show')
                }}
                title={{if
                  cred.showPassword
                  (t 'offensiveSecurity.hide')
                  (t 'offensiveSecurity.show')
                }}
                data-test-show-hide-btn={{index}}
                {{on 'click' (fn this.toggleShowPassword index)}}
              >
                <AkIcon
                  @iconName={{if
                    cred.showPassword
                    'visibility-off'
                    'visibility'
                  }}
                  @size='small'
                />
              </AkIconButton>
            </:rightAdornment>
          </AkTextField>

          <AkIconButton
            @type='button'
            @size='small'
            local-class='remove-cred-btn'
            data-test-remove-cred-btn={{index}}
            {{on 'click' (fn this.removeCredential index)}}
          >
            <AkIcon @iconName='delete' @size='small' />
          </AkIconButton>
        </div>
      {{/each}}
    </div>
  </div>

  <div local-class='card-footer'>
    <AkButton
      @variant='outlined'
      @color='neutral'
      @type='button'
      data-test-add-role-btn
      {{on 'click' this.addCredential}}
    >
      <:leftIcon>
        <AkIcon @iconName='add' @size='small' />
      </:leftIcon>

      <:default>{{t 'offensiveSecurity.addAnotherCredential'}}</:default>
    </AkButton>
  </div>
</form>