<div local-class='new-assessment-container' data-test-offsec-new-assessment>
  <AkBreadcrumbs::AutoTrail class='mb-2' />

  <div local-class='header-card' data-test-new-assessment-header-card>
    <AkTypography
      @variant='h5'
      @fontWeight='bold'
      data-test-new-assessment-title
    >
      {{t 'offensiveSecurity.startNewAssessment'}}
    </AkTypography>

    <AkTypography @variant='body2' data-test-new-assessment-subtitle>
      {{#if this.hasUploadedApp}}
        {{t 'offensiveSecurity.startNewAssessmentReadySubtitle'}}
      {{else}}
        {{t 'offensiveSecurity.startNewAssessmentSubtitle'}}
      {{/if}}
    </AkTypography>
  </div>

  <div local-class='layout-grid'>
    <ol local-class='steps-list' data-test-new-assessment-steps>
      <OffensiveSecurity::NewAssessment::Step
        @number={{1}}
        @state={{this.uploadStepState}}
      >
        {{#if this.hasUploadedApp}}
          <div local-class='card build-card' data-test-uploaded-build-card>
            <div local-class='platform-icon-box'>
              <AkIcon @iconName={{if this.isIosBuild 'ios' 'android'}} />
            </div>

            <div local-class='build-meta'>
              <AkTypography @variant='body3' @color='textSecondary'>
                {{t 'offensiveSecurity.uploadBuild'}}
              </AkTypography>

              <AkStack @alignItems='center' @spacing='1.5'>
                <AkTypography
                  @fontWeight='bold'
                  @noWrap={{true}}
                  title={{this.uploadedFile.name}}
                  data-test-uploaded-filename
                >
                  {{this.uploadedFile.name}}
                </AkTypography>

                <AkTypography @color='textSecondary' @noWrap={{true}}>
                  {{this.formattedFileSize}}
                </AkTypography>
              </AkStack>
            </div>

            <AkButton
              @variant='outlined'
              @color='neutral'
              @type='button'
              data-test-change-build-btn
              {{on 'click' this.changeBuild}}
            >
              <:leftIcon>
                <AkIcon @iconName='swap-horiz' />
              </:leftIcon>

              <:default>{{t 'offensiveSecurity.changeBuild'}}</:default>
            </AkButton>
          </div>
        {{else}}
          <section>
            <div local-class='step-heading'>
              <AkTypography @variant='subtitle1' @fontWeight='bold'>
                {{t 'offensiveSecurity.uploadBuild'}}
              </AkTypography>

              <AkTypography @variant='body2' @color='textSecondary'>
                {{t 'offensiveSecurity.uploadBuildSubtitle'}}
              </AkTypography>
            </div>

            {{#let
              (file-queue name=this.fileQueueName onFileAdded=this.onFileAdded)
              as |queue|
            }}
              <FileDropzone @queue={{queue}} as |dropzone|>
                <label
                  local-class='dropzone-area {{if
                    dropzone.active
                    "is-dragover"
                  }} {{if this.isUploading "is-uploading"}}'
                  data-test-new-assessment-dropzone
                >
                  <input
                    type='file'
                    accept='.apk,.ipa,.aab'
                    local-class='hidden-file-input'
                    data-test-file-input
                    {{queue.selectFile}}
                  />

                  <span local-class='dropzone-icon-circle'>
                    <AkIcon
                      @iconName={{if
                        this.isUploading
                        'autorenew'
                        'cloud-upload'
                      }}
                      local-class={{if this.isUploading 'spinner-icon'}}
                    />
                  </span>

                  {{#if this.isUploading}}
                    <AkTypography @variant='h6' @fontWeight='bold'>
                      {{t 'uploading'}}
                      {{this.currentFile.name}}
                    </AkTypography>

                    <div local-class='progress-container'>
                      <AkLoader::Linear
                        @variant={{if
                          (gt this.progress 0)
                          'determinate'
                          'indeterminate'
                        }}
                        @progress={{this.progress}}
                        @color='success'
                        @height={{8}}
                        data-test-upload-progress-bar
                      >
                        <:label>
                          <span local-class='progress-percentage'>
                            {{this.progress}}%
                          </span>
                        </:label>
                      </AkLoader::Linear>
                    </div>
                  {{else}}
                    <AkTypography @variant='h6' @fontWeight='bold'>
                      {{t 'offensiveSecurity.dropAppToBrowse'}}
                    </AkTypography>

                    <AkTypography
                      @variant='body2'
                      @color='textSecondary'
                      local-class='dropzone-notice'
                    >
                      {{t 'offensiveSecurity.dropAppNotice'}}
                    </AkTypography>
                  {{/if}}
                </label>
              </FileDropzone>
            {{/let}}
          </section>
        {{/if}}
      </OffensiveSecurity::NewAssessment::Step>

      <OffensiveSecurity::NewAssessment::Step
        @number={{2}}
        @state={{this.typeStepState}}
      >
        {{#if this.hasUploadedApp}}
          <OffensiveSecurity::NewAssessment::AssessmentType />
        {{else}}
          <section
            local-class='card locked-card'
            data-test-assessment-type-locked
          >
            <AkTypography @variant='subtitle1' @fontWeight='bold'>
              {{t 'offensiveSecurity.assessmentType'}}
            </AkTypography>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'offensiveSecurity.assessmentTypeLockedNote'}}
            </AkTypography>
          </section>
        {{/if}}
      </OffensiveSecurity::NewAssessment::Step>

      <OffensiveSecurity::NewAssessment::Step
        @number={{3}}
        @state={{this.credentialsStepState}}
        @isLast={{true}}
      >
        {{#if this.hasUploadedApp}}
          <OffensiveSecurity::NewAssessment::Credentials />
        {{else}}
          <section local-class='card locked-card' data-test-credentials-locked>
            <AkTypography @variant='subtitle1' @fontWeight='bold'>
              {{t 'offensiveSecurity.testCredentials'}}
            </AkTypography>

            <AkTypography @variant='body2' @color='textSecondary'>
              {{t 'offensiveSecurity.testCredentialsLockedNote'}}
            </AkTypography>
          </section>
        {{/if}}
      </OffensiveSecurity::NewAssessment::Step>
    </ol>

    <aside local-class='summary-column'>
      <OffensiveSecurity::NewAssessment::Summary
        @isUploading={{this.isUploading}}
        @uploadProgress={{this.progress}}
        @uploadingFileName={{this.currentFile.name}}
        @isIosBuild={{this.isIosBuild}}
        @formattedFileSize={{this.formattedFileSize}}
        @isStartingAssessment={{this.isStartingAssessment}}
        @isBeginDisabled={{this.isBeginDisabled}}
        @beginLabel={{this.beginCtaLabel}}
        @onBegin={{this.beginAssessment}}
      />
    </aside>
  </div>
</div>