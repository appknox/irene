<div {{style display='flex' justifyContent='center' alignItems='center'}}>
  {{#if @scan.isComprehensive}}
    <span
      local-class='scan-type-badge scan-type-comprehensive'
      data-test-offensiveSecurity-attackRuns-scanType='comprehensive'
    >
      <AkIcon @iconName='target' @size='small' local-class='scan-type-icon' />
      <span>{{t 'offensiveSecurity.comprehensive'}}</span>
    </span>
  {{else}}
    <span
      local-class='scan-type-badge scan-type-resilience'
      data-test-offensiveSecurity-attackRuns-scanType='resilience'
    >
      <AkIcon @iconName='shield' @size='small' local-class='scan-type-icon' />
      <span>{{t 'offensiveSecurity.resilienceOnly'}}</span>
    </span>
  {{/if}}
</div>