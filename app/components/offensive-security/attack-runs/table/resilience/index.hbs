{{#if @scan.hasResilience}}
  <span
    local-class='risk-badge risk-{{@scan.resilienceClass}}'
    data-test-offensiveSecurity-attackRuns-resilienceBadge
  >
    <strong>{{@scan.overallResilience}}/100</strong>
    {{t (concat 'offensiveSecurity.resilienceLevel.' @scan.resilienceClass)}}
  </span>
{{else if @scan.riskClass}}
  <span
    local-class='risk-badge risk-{{@scan.riskClass}}'
    data-test-offensiveSecurity-attackRuns-riskBadge
    data-test-offensiveSecurity-attackRuns-resilienceEmpty
  >
    {{t (concat 'offensiveSecurity.riskLevel.' @scan.riskClass)}}
  </span>
{{else}}
  <AkTypography
    @variant='body2'
    @color='textSecondary'
    data-test-offensiveSecurity-attackRuns-resilienceEmpty
  >
    &mdash;
  </AkTypography>
{{/if}}
