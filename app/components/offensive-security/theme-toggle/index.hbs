<AkTooltip
  @placement='bottom'
  @arrow={{true}}
  @title={{t 'offensiveSecurity.toggleTheme'}}
>
  <button
    type='button'
    class={{@buttonClass}}
    local-class='theme-toggle'
    aria-label={{t 'offensiveSecurity.toggleTheme'}}
    aria-pressed={{if this.offsecTheme.isDark 'true' 'false'}}
    data-test-offensiveSecurity-themeToggle
    {{on 'click' this.offsecTheme.toggle}}
  >
    <svg
      width='18'
      height='18'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
      aria-hidden='true'
    >
      <circle cx='12' cy='12' r='9'></circle>
      <path d='M12 3a9 9 0 0 1 0 18z' fill='currentColor'></path>
    </svg>
  </button>
</AkTooltip>