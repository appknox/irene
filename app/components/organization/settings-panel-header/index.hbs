<AkStack
  data-test-orgSettingsPanelHeader
  @width='full'
  @spacing='1.5'
  @alignItems='center'
  @justifyContent='space-between'
  ...attributes
>
  <AkStack @spacing='1.5' @alignItems='center'>
    {{#if @iconName}}
      <AkStack
        @alignItems='center'
        @justifyContent='center'
        local-class='panel-icon'
        data-test-orgSettingsPanelHeader-icon
        aria-hidden='true'
      >
        <AkIcon @iconName={{@iconName}} @color='primary' />
      </AkStack>
    {{/if}}

    <AkStack
      data-test-orgSettingsPanelHeader-titleColumn
      @direction='column'
      @spacing='0.5'
    >
      {{yield to='title'}}

      {{#if @description}}
        <AkTypography
          local-class='panel-description'
          data-test-orgSettingsPanelHeader-description
          @color='textSecondary'
          @variant='body2'
        >
          {{@description}}
        </AkTypography>
      {{/if}}
    </AkStack>
  </AkStack>

  <div local-class='panel-action' data-test-orgSettingsPanelHeader-action>
    {{yield to='action'}}
  </div>
</AkStack>