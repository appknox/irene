{{#if this.visible}}
  <div
    local-class='signing-cert-container'
    data-test-orgSigningCert
    ...attributes
  >
    {{#if this.isProjectScope}}
      {{! Section heading for the project's General Settings page — the org
      scope already sits under an "Organization Settings" heading. }}
      <AkTypography
        @variant='h6'
        class='mb-1'
        data-test-orgSigningCert-sectionTitle
      >
        {{t 'cyod'}}
      </AkTypography>
    {{/if}}

    <Organization::SettingsPanelHeader
      @iconName='verified-user'
      @description={{if
        this.isProjectScope
        (t 'orgSigningCertDescProject')
        (t 'orgSigningCertDesc')
      }}
    >
      <:title>
        <AkTypography @variant='h6' data-test-orgSigningCert-title>
          {{t 'orgSigningCertTitle'}}
        </AkTypography>
      </:title>

      <:action>
        <AkButton
          data-test-orgSigningCert-openBtn
          @variant='filled'
          {{on 'click' this.handleOpen}}
        >
          {{t 'orgSigningCertAdd'}}
        </AkButton>
      </:action>
    </Organization::SettingsPanelHeader>
  </div>

  {{#if this.showModal}}
    <AkModal
      data-test-orgSigningCert-modal
      @showHeader={{true}}
      @headerTitle={{t 'orgSigningCertAdd'}}
      @onClose={{this.handleClose}}
    >
      <AkTabs data-test-orgSigningCert-tabs as |Akt|>
        <Akt.tabItem
          data-test-orgSigningCert-addTab
          @id='add'
          @buttonVariant={{true}}
          @isActive={{eq this.activeTab 'add'}}
          @onTabClick={{fn this.handleTabChange 'add'}}
        >
          {{t 'orgSigningCertAdd'}}
        </Akt.tabItem>

        <Akt.tabItem
          data-test-orgSigningCert-existingTab
          @id='existing'
          @buttonVariant={{true}}
          @isActive={{eq this.activeTab 'existing'}}
          @onTabClick={{fn this.handleTabChange 'existing'}}
        >
          {{t 'orgSigningCertExistingTab'}}
        </Akt.tabItem>
      </AkTabs>

      {{#if (eq this.activeTab 'add')}}
        {{! ---------------- Add certificate ---------------- }}
        <form {{on 'submit' (perform this.upload)}}>
          <AkStack @direction='column' @spacing='2.5' class='pa-3'>
            <AkStack @spacing='2' @alignItems='flex-start'>
              <div local-class='form-field'>
                <AkTextField
                  data-test-orgSigningCert-name
                  @label={{t 'orgSigningCertName'}}
                  @placeholder={{t 'orgSigningCertNamePlaceholder'}}
                  @value={{this.certName}}
                  {{on 'input' this.setName}}
                />
              </div>

              <div local-class='form-field'>
                <AkTextField
                  data-test-orgSigningCert-bundleId
                  @label={{t 'orgSigningCertBundleIdLabel'}}
                  @placeholder='com.mfva.myapp'
                  @value={{this.bundleId}}
                  {{on 'input' this.setBundleId}}
                />
              </div>
            </AkStack>

            <div local-class='tip-callout' data-test-orgSigningCert-tip>
              <AkTypography @variant='body3' @color='textSecondary'>
                <strong>{{t 'orgSigningCertTipLabel'}}</strong>
                {{t 'orgSigningCertBundleIdHint'}}
              </AkTypography>
            </div>

            <AkDivider @color='light' />

            {{! Signing identity (.p12) }}
            <AkStack @direction='column' @spacing='0.5'>
              <AkTypography @variant='body3' @color='textSecondary' @tag='label'>
                {{t 'orgSigningCertP12'}}
              </AkTypography>

              <AkStack @spacing='1' @alignItems='center'>
                <AkButton @tag='label' @variant='outlined'>
                  <AkIcon @iconName='cloud-upload' @size='small' />

                  <span class='ml-1'>{{t 'chooseFile'}}</span>

                  <input
                    type='file'
                    accept='.p12,.pfx'
                    aria-label={{t 'orgSigningCertP12'}}
                    data-test-orgSigningCert-p12
                    {{style display='none'}}
                    {{on 'change' this.setP12}}
                  />
                </AkButton>

                <AkTypography
                  local-class='file-name'
                  @variant='body3'
                  @color={{if this.p12FileName 'textPrimary' 'textSecondary'}}
                >
                  {{if this.p12FileName this.p12FileName (t 'noFileChosen')}}
                </AkTypography>
              </AkStack>
            </AkStack>

            <AkTextField
              data-test-orgSigningCert-password
              @label={{t 'orgSigningCertPassword'}}
              @placeholder={{t 'orgSigningCertPasswordPlaceholder'}}
              @type='password'
              @value={{this.password}}
              autocomplete='new-password'
              {{on 'input' this.setPassword}}
            />

            {{! Provisioning profile }}
            <AkStack @direction='column' @spacing='0.5'>
              <AkTypography @variant='body3' @color='textSecondary' @tag='label'>
                {{t 'orgSigningCertProfile'}}
              </AkTypography>

              <AkStack @spacing='1' @alignItems='center'>
                <AkButton @tag='label' @variant='outlined'>
                  <AkIcon @iconName='cloud-upload' @size='small' />

                  <span class='ml-1'>{{t 'chooseFile'}}</span>

                  <input
                    type='file'
                    accept='.mobileprovision'
                    aria-label={{t 'orgSigningCertProfile'}}
                    data-test-orgSigningCert-profile
                    {{style display='none'}}
                    {{on 'change' this.setProfile}}
                  />
                </AkButton>

                <AkTypography
                  local-class='file-name'
                  @variant='body3'
                  @color={{if
                    this.profileFileName
                    'textPrimary'
                    'textSecondary'
                  }}
                >
                  {{if
                    this.profileFileName
                    this.profileFileName
                    (t 'noFileChosen')
                  }}
                </AkTypography>
              </AkStack>
            </AkStack>

            <AkDivider @color='light' />

            <AkStack @spacing='1'>
              <AkButton
                data-test-orgSigningCert-uploadBtn
                @type='submit'
                @variant='filled'
                @disabled={{not this.canSave}}
                @loading={{this.upload.isRunning}}
              >
                {{t 'save'}}
              </AkButton>

              <AkButton @variant='outlined' {{on 'click' this.handleClose}}>
                {{t 'cancel'}}
              </AkButton>
            </AkStack>
          </AkStack>
        </form>

      {{else}}
        {{! ---------------- Existing certificates ---------------- }}
        <AkStack @direction='column' @spacing='2' class='pa-3'>
          {{#if this.load.isRunning}}
            <AkStack @spacing='1' @alignItems='center'>
              <AkLoader @size={{16}} />

              <AkTypography @variant='body2' @color='textSecondary'>
                {{t 'loading'}}
              </AkTypography>
            </AkStack>

          {{else if this.hasExistingCerts}}
            {{#each this.existingCerts as |cert|}}
              <div local-class='cert-card' data-test-orgSigningCert-info>
                <AkStack
                  @alignItems='flex-start'
                  @justifyContent='space-between'
                  @spacing='2'
                >
                  <AkStack @direction='column' @spacing='1'>
                    <AkStack @spacing='1' @alignItems='center'>
                      <AkTypography @variant='body1' @fontWeight='medium'>
                        {{if cert.name cert.name (t 'orgSigningCertUnnamed')}}
                      </AkTypography>

                      {{#if (or cert.is_active this.isProjectScope)}}
                        <AkChip
                          data-test-orgSigningCert-activeBadge
                          @variant='filled'
                          @size='small'
                          @color='success'
                          @label={{t 'orgSigningCertActiveBadge'}}
                        />
                      {{/if}}

                      <AkChip
                        data-test-orgSigningCert-status
                        @variant='semi-filled'
                        @size='small'
                        @color={{this.certStatusColor cert}}
                        @label={{if
                          cert.is_expired
                          (t 'orgSigningCertStatusExpired')
                          (t 'orgSigningCertStatusValid')
                        }}
                      />
                    </AkStack>

                    <AkStack @direction='column' @spacing='0.5'>
                      <AkStack @spacing='1' @alignItems='center'>
                        <AkTypography @variant='body3' @color='textSecondary'>
                          {{t 'orgSigningCertTeam'}}
                        </AkTypography>

                        <AkTypography local-class='mono-value' @variant='body3'>
                          {{cert.team_id}}
                        </AkTypography>
                      </AkStack>

                      {{#if cert.app_id}}
                        <AkStack @spacing='1' @alignItems='center'>
                          <AkTypography @variant='body3' @color='textSecondary'>
                            {{t 'orgSigningCertAppId'}}
                          </AkTypography>

                          <AkTypography
                            local-class='mono-value'
                            @variant='body3'
                          >
                            {{cert.app_id}}
                          </AkTypography>
                        </AkStack>
                      {{/if}}

                      <AkStack @spacing='1' @alignItems='center'>
                        <AkTypography @variant='body3' @color='textSecondary'>
                          {{t 'orgSigningCertExpires'}}
                        </AkTypography>

                        <AkTypography
                          @variant='body3'
                          @color={{if cert.is_expired 'error' 'textPrimary'}}
                        >
                          {{cert.expires_at}}
                        </AkTypography>
                      </AkStack>
                    </AkStack>
                  </AkStack>

                  <AkStack @spacing='1' @alignItems='center'>
                    {{#if (and this.canActivate (not cert.is_active))}}
                      <AkButton
                        data-test-orgSigningCert-activateBtn
                        @variant='outlined'
                        @loading={{and
                          this.activateCert.isRunning
                          (eq this.busyCertId cert.id)
                        }}
                        {{on 'click' (fn (perform this.activateCert) cert)}}
                      >
                        {{t 'orgSigningCertMakeActive'}}
                      </AkButton>
                    {{/if}}

                    {{#if this.isProjectScope}}
                      <AkIconButton
                        data-test-orgSigningCert-deleteBtn
                        @size='small'
                        title={{t 'delete'}}
                        {{on 'click' (perform this.deleteCert)}}
                      >
                        <AkIcon @iconName='delete' @color='textSecondary' />
                      </AkIconButton>
                    {{else}}
                      <AkIconButton
                        data-test-orgSigningCert-deleteBtn
                        @size='small'
                        disabled={{cert.is_active}}
                        title={{if
                          cert.is_active
                          (t 'orgSigningCertDeleteActiveHint')
                          (t 'delete')
                        }}
                        {{on 'click' (fn (perform this.deleteOrgCert) cert)}}
                      >
                        <AkIcon @iconName='delete' @color='textSecondary' />
                      </AkIconButton>
                    {{/if}}
                  </AkStack>
                </AkStack>
              </div>
            {{/each}}

          {{else}}
            <div local-class='empty-state' data-test-orgSigningCert-empty>
              <AkIcon @iconName='verified-user' @color='textSecondary' />

              <AkTypography @variant='body2' @color='textSecondary'>
                {{t 'orgSigningCertNone'}}
              </AkTypography>
            </div>
          {{/if}}
        </AkStack>
      {{/if}}
    </AkModal>
  {{/if}}
{{/if}}
