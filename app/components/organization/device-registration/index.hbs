<div
  local-class='device-registration-container'
  data-test-orgDeviceRegistration
  ...attributes
>
  <AkStack @alignItems='flex-start' @justifyContent='space-between' @spacing='2'>
    <AkStack @direction='column' @spacing='0.5'>
      <AkTypography @variant='h6' data-test-orgDeviceRegistration-title>
        {{t 'cyodRegistration.title'}}
      </AkTypography>

      <AkTypography
        @variant='body2'
        @color='textSecondary'
        data-test-orgDeviceRegistration-description
      >
        {{t 'cyodRegistration.description'}}
      </AkTypography>
    </AkStack>

    <AkToggle
      data-test-orgDeviceRegistration-toggle
      @id='cyod-registration'
      @checked={{this.isRegistrationEnabled}}
      @disabled={{this.isSaving}}
      @size='small'
      @onChange={{perform this.setRegistrationEnabled}}
    />
  </AkStack>

  {{#if this.isRegistrationEnabled}}
    <div class='mt-2'>
      <Cyod::DeviceTable @emptyHint={{t 'cyodRegistration.emptyHint'}}>
        <:emptyAction>
          <AkLink
            data-test-orgDeviceRegistration-goToCyodSettings
            @route='authenticated.dashboard.account-settings.cyod-settings'
            @color='primary'
            @underline='always'
            @typographyVariant='body2'
          >
            <:default>
              {{t 'cyodRegistration.goToCyodSettings'}}
            </:default>

            <:rightIcon>
              <AkIcon @iconName='open-in-new' @size='small' @color='primary' />
            </:rightIcon>
          </AkLink>
        </:emptyAction>
      </Cyod::DeviceTable>
    </div>
  {{/if}}
</div>
