<AkStack
  @direction='column'
  @spacing='2.5'
  {{did-update
    this.refetchHistory
    this.limit
    this.offset
    @queryParams.file_id
  }}
>
  <AkBreadcrumbs::AutoTrail data-test-knoxIqAutofixHistory-breadcrumbs />

  <AkPaginationProvider
    @results={{this.runs}}
    @onItemPerPageChange={{this.updatePagination}}
    @totalItems={{this.totalAutofixPRs}}
    @nextAction={{this.updatePagination}}
    @prevAction={{this.updatePagination}}
    @itemPerPageOptions={{array 10 20 30}}
    @defaultLimit={{this.limit}}
    @offset={{this.offset}}
    as |pgc|
  >
    {{#if this.isInitialLoading}}
      <AkStack
        class='py-7'
        @alignItems='center'
        @justifyContent='center'
        data-test-knoxIqAutofixHistory-loading
      >
        <AkLoader @size={{32}} />
      </AkStack>
    {{else if this.hasNoHistory}}
      <AkStack
        class='py-7'
        @alignItems='center'
        @justifyContent='center'
        @direction='column'
        @spacing='1'
        data-test-knoxIqAutofixHistory-empty
      >
        <AkIcon @iconName='history' @size='medium' @color='textSecondary' />
        <AkTypography @variant='h5'>
          {{t 'autofix.emptyTitle'}}
        </AkTypography>
        <AkTypography @color='textSecondary' @align='center'>
          {{t 'autofix.emptyDescription'}}
        </AkTypography>
      </AkStack>
    {{else}}
      <AkTable
        @hoverable={{true}}
        local-class='runs-table'
        data-test-knoxIqAutofixHistory-table
        as |tb|
      >
        <tb.head @columns={{this.columns}} as |h|>
          <h.row as |r|>
            <r.cell
              data-test-knoxIqAutofixHistory-header={{r.columnValue.valuePath}}
              as |column|
            >
              {{column.name}}
            </r.cell>
          </h.row>
        </tb.head>

        <tb.body @rows={{pgc.currentPageResults}} as |b|>
          <b.row
            @onClick={{this.openRun}}
            local-class='run-row'
            data-test-knoxIqAutofixHistory-row
            as |r|
          >
            <r.cell>
              {{#if (eq r.columnValue.valuePath 'baseBranch')}}
                <AkStack @alignItems='center' @spacing='0.5'>
                  <AkSvg::GitBranch local-class='meta-icon' />
                  <AkTypography
                    @tag='span'
                    @breakWord={{true}}
                    data-test-knoxIqAutofixHistory-baseBranch
                  >
                    {{r.rowValue.baseBranch}}
                  </AkTypography>
                </AkStack>
              {{/if}}

              {{#if (eq r.columnValue.valuePath 'branch')}}
                <AkStack @alignItems='center' @spacing='0.5'>
                  <AkSvg::GitBranchSparkle local-class='meta-icon' />
                  <AkTypography
                    @tag='span'
                    @breakWord={{true}}
                    data-test-knoxIqAutofixHistory-branch
                  >
                    {{r.rowValue.branch}}
                  </AkTypography>
                </AkStack>
              {{/if}}

              {{#if (eq r.columnValue.valuePath 'commitSha')}}
                <AkStack @alignItems='center' @spacing='0.5'>
                  <AkSvg::GitCommit local-class='meta-icon' />

                  <AkTooltip @title={{r.rowValue.commitSha}} @placement='top'>
                    <a
                      href={{r.rowValue.commitUrl}}
                      target='_blank'
                      rel='noopener noreferrer'
                      aria-label={{t
                        'autofix.openCommit'
                        sha=r.rowValue.commitSha
                      }}
                      local-class='commit-link'
                      {{on 'click' this.stopRowNavigation}}
                      data-test-knoxIqAutofixHistory-commitLink
                    >
                      <span>{{r.rowValue.shortSha}}</span>
                      <AkIcon @iconName='open-in-new' @color='primary' />
                    </a>
                  </AkTooltip>
                </AkStack>
              {{/if}}

              {{#if (eq r.columnValue.valuePath 'updatedOn')}}
                <AkTypography
                  @color='textSecondary'
                  @tag='span'
                  data-test-knoxIqAutofixHistory-updatedOn
                >
                  {{dayjs-from-now r.rowValue.updatedOn}}
                </AkTypography>
              {{/if}}
            </r.cell>
          </b.row>
        </tb.body>
      </AkTable>

      <AkPagination
        class='mt-3'
        @disableNext={{pgc.disableNext}}
        @nextAction={{pgc.nextAction}}
        @disablePrev={{pgc.disablePrev}}
        @prevAction={{pgc.prevAction}}
        @endItemIdx={{pgc.endItemIdx}}
        @startItemIdx={{pgc.startItemIdx}}
        @itemPerPageOptions={{pgc.itemPerPageOptions}}
        @onItemPerPageChange={{pgc.onItemPerPageChange}}
        @selectedOption={{pgc.selectedOption}}
        @totalItems={{pgc.totalItems}}
        @tableItemLabel={{t 'autofix.pullRequests'}}
        @perPageTranslation={{t 'autofix.itemsPerPage'}}
        data-test-knoxIqAutofixHistory-pagination
      />
    {{/if}}
  </AkPaginationProvider>
</AkStack>

<KnoxIq::AutofixHistory::RunDrawer
  @run={{this.selectedRun}}
  @onClose={{this.closeRun}}
/>
