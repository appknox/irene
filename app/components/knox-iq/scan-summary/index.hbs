<AkStack
  @direction='column'
  @width='full'
  local-class='scan-summary-root'
  data-test-knoxiq-scan-summary
>
  <div
    local-class='scan-summary-accent {{this.scanSummaryAccentClass}}'
    data-test-knoxiq-scan-summary-accent
  ></div>

  <AkStack
    @direction='row'
    @width='full'
    @alignItems='center'
    @justifyContent='space-between'
    local-class='scan-summary-header'
  >
    <AkStack @direction='row' @spacing='1' @alignItems='center'>
      <AkIcon
        @iconName='majesticons:pulse'
        data-test-knoxiq-scan-summary-icon
      />

      <AkTypography @variant='subtitle1' data-test-knoxiq-scan-summary-title>
        {{t 'scanSummary'}}
      </AkTypography>
    </AkStack>

    {{#if (or this.autofixProjectId this.compareRouteModel)}}
      <AkStack @alignItems='center' @spacing='2'>
        {{#if this.autofixProjectId}}
          <AkLink
            @route='authenticated.dashboard.project.autofix'
            @model={{this.autofixProjectId}}
            @query={{hash file_id=@file.id}}
            @color='textPrimary'
            @underline='always'
            @fontWeight='medium'
            @typographyVariant='body2'
            data-test-knoxiq-scan-summary-autofix-link
          >
            <:default>
              {{t 'autofix.detailsTitle'}}
            </:default>

            <:rightIcon>
              <AkIcon @iconName='arrow-outward' />
            </:rightIcon>
          </AkLink>
        {{/if}}

        {{#if this.compareRouteModel}}
          <AkLink
            @route='authenticated.dashboard.compare'
            @model={{this.compareRouteModel}}
            @color='primary'
            @underline='always'
            data-test-knoxiq-scan-summary-key-insights-link
          >
            <:default>
              {{t 'keyInsights'}}
            </:default>

            <:rightIcon>
              <AkIcon @iconName='arrow-outward' />
            </:rightIcon>
          </AkLink>
        {{/if}}
      </AkStack>
    {{/if}}
  </AkStack>

  <AkStack
    @direction='row'
    @width='full'
    @spacing='6'
    @alignItems='stretch'
    local-class='scan-summary-body'
    data-test-knoxiq-scan-summary-body
  >
    <AkStack
      @direction={{if this.hasHealthScore 'column' 'row'}}
      @spacing='6'
      local-class='scan-summary-primary'
    >
      <KnoxIq::ScanSummary::Exploitability @file={{@file}} />

      <KnoxIq::ScanSummary::Severity @file={{@file}} />
    </AkStack>

    {{#if this.hasHealthScore}}
      <AkStack local-class='scan-summary-health-score'>
        <FileDetails::SeverityLevel::HealthScore
          @file={{@file}}
          @isCompact={{true}}
        />
      </AkStack>
    {{/if}}
  </AkStack>
</AkStack>