<AkStack
  @direction='column'
  @width='full'
  @justifyContent='space-between'
  {{style flex='1'}}
>
  {{#if @isKnoxiqEnabled}}
    <div
      local-class='static-scan-accent {{this.staticScanAccentClass}}'
      data-test-fileDetailScanActions-staticScan-accent
    ></div>
  {{/if}}

  <AkStack
    @width='full'
    @justifyContent='space-between'
    @alignItems='center'
    @flexWrap='nowrap'
    class='p-2'
    data-test-cy='staticScan-infoContainer'
  >
    <AkTypography @variant='h5' data-test-fileDetailScanActions-staticScanTitle>
      {{t 'staticScan'}}
    </AkTypography>

    {{#if @file.isStaticCompleted}}
      {{#if this.showKnoxiqStatusChip}}
        <KnoxIq::StatusChip @state={{this.knoxiqStatusChipState}} />
      {{else}}
        <AkChip
          @label={{t 'completed'}}
          @color='success'
          @variant='semi-filled'
          @size='small'
          local-class='chips-uppercase'
          data-test-fileDetailScanActions-staticScanCompletedStatus
        />
      {{/if}}
    {{else if (or (eq @file.isStaticScanStarted true) (eq @file.isStaticScanStarted undefined))}}
      <AkStack @alignItems='center' local-class='scanning-chip chips-uppercase'>
        <AkLoader @size={{12}} />

        <AkTypography
          @color='textSecondary'
          @fontWeight='bold'
          local-class='scanning-text'
          data-test-fileDetailScanActions-staticScanInProgressStatus
        >
          {{t 'scanning'}}...
          {{@file.staticScanProgress}}%
        </AkTypography>
      </AkStack>
    {{else}}
      <AkButton
        @variant='filled'
        @color='primary'
        @loading={{this.initiateStaticScanTask.isRunning}}
        {{on 'click' this.handleInitiateStaticScan}}
        local-class='initiate-scan-btn'
        data-test-fileDetailScanActions-initiateStaticScanBtn
      >
        Initiate static scan
      </AkButton>
    {{/if}}
  </AkStack>

  <FileDetails::ScanActions::ScanOverview
    @file={{@file}}
    @vulnerabilityCount={{if @file.isStaticCompleted @vulnerabilityCount null}}
    data-test-fileDetails-scanActions-scanOverview-staticScanRoot
  />
</AkStack>

<AkDivider @color='dark' />

<AkLink
  @color='primary'
  @underline='always'
  @fontWeight='bold'
  @route='authenticated.dashboard.file.static-scan'
  @model={{@file.id}}
  class='px-2 py-1'
  local-class='view-details-icon'
  data-test-fileDetailScanActions-staticScanViewDetails
>
  <:default>
    {{t 'viewDetails'}}
  </:default>

  <:rightIcon>
    <AkIcon @iconName='arrow-right' />
  </:rightIcon>
</AkLink>