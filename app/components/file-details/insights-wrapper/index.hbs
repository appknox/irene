<div local-class='bordered-box'>
  <AkTabs local-class='tabs-container' as |akt|>
    {{#each this.tabItems as |item|}}
      <akt.tabItem
        @id={{item.id}}
        @buttonVariant={{true}}
        @onTabClick={{this.handleTabClick}}
        @isActive={{eq item.id this.selectedTab}}
        data-test-fileDetailsInsightsWrapper-tab={{item.id}}
      >
        {{item.label}}
      </akt.tabItem>
    {{/each}}
  </AkTabs>

  {{#let (component this.activeTabComponent) as |Component|}}
    <Component
      @file={{@file}}
      @fileAnalyses={{@fileAnalysesListContext.analyses}}
      @isFetchingAnalyses={{@fileAnalysesListContext.isFetchingAnalyses}}
    />
  {{/let}}
</div>