<AkStack
  local-class='scoring-methodology'
  @direction='column'
  @spacing='2'
  @width='full'
>
  <AkTypography @variant='body2' local-class='methodology-description'>
    {{t 'healthScore.scoringMethodology.desc1'}}
  </AkTypography>

  {{#each this.formulaItems as |item|}}
    <AkStack @direction='column' @spacing='1' @width='full'>
      <AkTypography @variant='subtitle2' @fontWeight='medium'>
        {{item.number}}.
        {{t item.titleKey}}
      </AkTypography>

      <AkStack local-class='answer-box' @width='full'>
        <AkTypography @variant='body2'>
          {{t item.answerKey}}
        </AkTypography>
      </AkStack>
    </AkStack>
  {{/each}}

  <AkStack @direction='column' @spacing='1.5' @width='full' local-class='methodology-section'>
    <AkTypography @variant='subtitle1' @fontWeight='bold'>
      {{t 'healthScore.scoringMethodology.adjustmentsTitle'}}
    </AkTypography>

    <AkStack @direction='column' @spacing='1.5' @width='full'>
      {{#each this.adjustments as |adj|}}
        <AkStack @direction='column' @spacing='0.5' @width='full'>
          <AkTypography @variant='subtitle2' @fontWeight='medium'>
            {{t adj.titleKey}}
          </AkTypography>

          <AkTypography @variant='body2'>
            {{t adj.descKey}}
          </AkTypography>
        </AkStack>
      {{/each}}
    </AkStack>
  </AkStack>

  <AkStack @direction='column' @spacing='1.5' @width='full' local-class='methodology-section'>
    <AkTypography @variant='subtitle1' @fontWeight='bold'>
      {{t 'healthScore.scoringMethodology.scoreBands'}}
    </AkTypography>

    <div local-class='score-bands'>
      <AkStack
        local-class='score-band-header'
        @justifyContent='space-between'
        @alignItems='center'
        @width='full'
      >
        <AkTypography @variant='body2' @fontWeight='bold'>
          {{t 'healthScore.scoringMethodology.score'}}
        </AkTypography>

        <AkTypography @variant='body2' @fontWeight='bold'>
          {{t 'healthScore.scoringMethodology.rating'}}
        </AkTypography>
      </AkStack>

      <AkDivider />

      {{#each this.scoreBands as |band|}}
        <AkStack
          local-class='score-band-row'
          @justifyContent='space-between'
          @alignItems='center'
          @width='full'
        >
          <AkTypography @variant='body2'>{{band.range}}</AkTypography>

          <AkChip
            local-class='rating-chip rating-chip--{{band.chipClass}}'
            @label={{t band.ratingKey}}
            @size='small'
            @fontWeight='medium'
          />
        </AkStack>

        <AkDivider />
      {{/each}}
    </div>
  </AkStack>

  <AkStack @direction='column' @spacing='1.5' @width='full' local-class='methodology-section'>
    <AkTypography @variant='subtitle1' @fontWeight='bold'>
      {{t 'healthScore.scoringMethodology.examples'}}
    </AkTypography>

    {{#each this.examples as |example|}}
      <AkStack
        local-class='example-card'
        @justifyContent='space-between'
        @alignItems='center'
        @spacing='2'
        @width='full'
      >
        <AkStack @direction='column' @spacing='0.5'>
          <AkTypography @variant='body2' @fontWeight='bold'>
            {{t example.nameKey}}
          </AkTypography>

          <AkTypography @variant='body2' @color='textSecondary'>
            {{t example.descKey}}
          </AkTypography>
        </AkStack>

        <AkStack @direction='column' @alignItems='flex-end' @spacing='0.5'>
          <AkTypography @fontWeight='bold'>{{example.score}}</AkTypography>

          <AkChip
            local-class='rating-chip rating-chip--{{example.badgeClass}}'
            @label={{t example.badgeKey}}
            @size='small'
            @fontWeight='medium'
          />
        </AkStack>
      </AkStack>
    {{/each}}

    <AkTypography @variant='body2' local-class='examples-note'>
      {{t 'healthScore.scoringMethodology.examplesNote'}}
    </AkTypography>
  </AkStack>
</AkStack>
