<AkDrawer
  data-test-healthScoreScoringDetails-drawer
  @open={{@open}}
  @onClose={{@onClose}}
  @anchor='right'
  as |dr|
>
  <AkStack
    data-test-healthScoreScoringDetails-drawerContainer
    local-class='scoring-details-drawer'
    @direction='column'
    @spacing='0'
  >
    <AkStack
      local-class='scoring-details-header'
      @direction='column'
      @spacing='2'
    >
      <AkStack
        @justifyContent='space-between'
        @width='full'
        @alignItems='flex-start'
      >
        <AkStack @direction='column' @spacing='0.5'>
          <AkTypography
            data-test-healthScoreScoringDetails-title
            @variant='h5'
            @fontWeight='bold'
          >
            {{t 'scoringAudit'}}
          </AkTypography>

          {{#if @fileId}}
            <AkTypography
              data-test-healthScoreScoringDetails-subtitle
              @variant='body2'
              @color='textSecondary'
            >
              {{t 'scoringAuditSubtitle' fileId=@fileId}}
            </AkTypography>
          {{/if}}
        </AkStack>

        <AkIconButton
          data-test-healthScoreScoringDetails-drawerCloseBtn
          {{on 'click' dr.closeHandler}}
        >
          <AkIcon @iconName='close' />
        </AkIconButton>
      </AkStack>

      <div
        local-class='scoring-details-score-box'
        {{style backgroundImage=this.scoreBoxGradient}}
      >
        <AkTypography
          local-class='scoring-details-score-label'
          @fontWeight='bold'
        >
          {{t 'securityHealthScore'}}
        </AkTypography>

        <AkStack @justifyContent='space-between' @alignItems='center'>
          <AkStack local-class='scoring-details-score-value' @direction='row'>
            <AkTypography
              data-test-healthScoreScoringDetails-score
              local-class='scoring-details-score-number'
              @fontWeight='bold'
            >
              {{this.score}}
            </AkTypography>

            <AkTypography
              local-class='scoring-details-score-max'
              @fontWeight='regular'
            >
              /100
            </AkTypography>
          </AkStack>

          {{#if this.statusLabel}}
            <AkChip
              data-test-healthScoreScoringDetails-statusChip
              local-class='scoring-details-status-chip scoring-details-status-chip--{{this.statusChipClass}}'
              @label={{this.statusLabel}}
              @size='small'
              @fontWeight='medium'
            />
          {{/if}}
        </AkStack>
      </div>

      <AkTypography
        data-test-healthScoreScoringDetails-summary
        local-class='scoring-details-summary'
        @variant='body2'
      >
        {{t 'healthScoreSummary'}}
      </AkTypography>

      <AkAccordion
        @isExpanded={{this.showScoringMethodology}}
        @summaryText={{t 'scoringMethodologyTitle'}}
        @summaryIconName='info'
        @onChange={{this.toggleScoringMethodology}}
        data-test-healthScoreScoringDetails-methodologyAccordion
      >
        <:content>
          <div local-class='score-methodology'>

            <AkTypography
              @variant='body2'
              local-class='methodology-description'
            >
              {{t 'scoringMethodologyDesc1'}}
            </AkTypography>

            <div local-class='formula-item'>
              <AkTypography
                @variant='subtitle2'
                @fontWeight='medium'
              >
                1. {{t 'scoringMethodologyQ1Title'}}
              </AkTypography>

              <div local-class='answer-box'>
                <AkTypography @variant='body2'>
                  {{t 'scoringMethodologyQ1Answer'}}
                </AkTypography>
              </div>
            </div>

            <div local-class='formula-item'>
              <AkTypography
                @variant='subtitle2'
                @fontWeight='medium'
              >
                2. {{t 'scoringMethodologyQ2Title'}}
              </AkTypography>

              <div local-class='answer-box'>
                <AkTypography @variant='body2'>
                  {{t 'scoringMethodologyQ2Answer'}}
                </AkTypography>
              </div>
            </div>

            <AkTypography
              @variant='subtitle2'
              @fontWeight='medium'
              local-class='adjustments-title'
            >
              {{t 'scoringMethodologyAdjustmentsTitle'}}
            </AkTypography>

            <ul local-class='adjustments-list'>
              <li>
                <strong>{{t 'scoringMethodologyAdjustmentCoverageTitle'}}</strong>
                — {{t 'scoringMethodologyAdjustmentCoverageDesc'}}
              </li>
              <li>
                <strong>{{t 'scoringMethodologyAdjustmentAcceptedTitle'}}</strong>
                — {{t 'scoringMethodologyAdjustmentAcceptedDesc'}}
              </li>
              <li>
                <strong>{{t 'scoringMethodologyAdjustmentSeverityTitle'}}</strong>
                — {{t 'scoringMethodologyAdjustmentSeverityDesc'}}
              </li>
            </ul>

            <AkTypography
              @variant='subtitle1'
              @fontWeight='bold'
              local-class='adjustments-title'
            >
              {{t 'scoringMethodologyScoreBands'}}
            </AkTypography>

            <table local-class='score-table'>
              <thead>
                <tr>
                  <th>{{t 'scoringMethodologyScore'}}</th>
                  <th>{{t 'scoringMethodologyRating'}}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>90 – 100</td>
                  <td>{{t 'scoringMethodologyRatingExcellent'}}</td>
                </tr>
                <tr>
                  <td>75 – 89</td>
                  <td>{{t 'scoringMethodologyRatingGood'}}</td>
                </tr>
                <tr>
                  <td>60 – 74</td>
                  <td>{{t 'scoringMethodologyRatingFair'}}</td>
                </tr>
                <tr>
                  <td>40 – 59</td>
                  <td>{{t 'scoringMethodologyRatingPoor'}}</td>
                </tr>
                <tr>
                  <td>0 – 39</td>
                  <td>{{t 'scoringMethodologyRatingVeryPoor'}}</td>
                </tr>
              </tbody>
            </table>

            <AkTypography
              @variant='subtitle1'
              @fontWeight='bold'
              local-class='examples-title'
            >
              {{t 'scoringMethodologyExamples'}}
            </AkTypography>

            <div local-class='example-card'>
              <div>
                <strong>{{t 'scoringMethodologyExampleAppA'}}</strong><br>
                {{t 'scoringMethodologyExampleAppADesc'}}
              </div>
              <div local-class='example-score'>
                <strong>49/100</strong>
                <span local-class='badge poor'>{{t 'scoringMethodologyRatingPoor'}}</span>
              </div>
            </div>

            <div local-class='example-card'>
              <div>
                <strong>{{t 'scoringMethodologyExampleAppB'}}</strong><br>
                {{t 'scoringMethodologyExampleAppBDesc'}}
              </div>
              <div local-class='example-score'>
                <strong>87/100</strong>
                <span local-class='badge good'>{{t 'scoringMethodologyRatingGood'}}</span>
              </div>
            </div>

            <div local-class='example-card'>
              <div>
                <strong>{{t 'scoringMethodologyExampleAppC'}}</strong><br>
                {{t 'scoringMethodologyExampleAppCDesc'}}
              </div>
              <div local-class='example-score'>
                <strong>27/100</strong>
                <span local-class='badge very-poor'>{{t 'scoringMethodologyRatingVeryPoor'}}</span>
              </div>
            </div>

            <AkTypography
              @variant='body2'
              local-class='examples-note'
            >
              {{t 'scoringMethodologyExamplesNote'}}
            </AkTypography>
          </div>
        </:content>
      </AkAccordion>
    </AkStack>

    <AkDivider local-class='scoring-details-divider' @color='dark' />

    <div local-class='scoring-details-timeline-section'>
      <AkStack
        local-class='scoring-details-timeline-header'
        @justifyContent='space-between'
        @alignItems='center'
      >
        <AkTypography
          local-class='scoring-details-timeline-heading'
          @fontWeight='bold'
        >
          {{t 'scoreBreakdownTimeline'}}
        </AkTypography>
      </AkStack>

      <ul local-class='scoring-details-timeline'>
        {{#each this.timelineEntries as |entry|}}
          <li
            data-test-healthScoreScoringDetails-timelineEntry
            local-class='scoring-details-timeline-entry'
          >
            <span local-class='scoring-details-timeline-marker' />

            <div local-class='scoring-details-timeline-content'>
              <AkStack
                @justifyContent='space-between'
                @alignItems='flex-start'
                @spacing='2'
              >
                <div local-class='scoring-details-timeline-main'>
                  <AkStack @direction='row' @spacing='1' @alignItems='center'>
                    <AkChip
                      data-test-healthScoreScoringDetails-dateChip
                      local-class='scoring-details-date-chip'
                      @label={{entry.dateLabel}}
                      @variant='outlined'
                      @size='small'
                    />

                    {{#if entry.isKnoxiqRan}}
                      <AkChip
                        data-test-healthScoreScoringDetails-aeisChip
                        local-class='scoring-details-aeis-chip'
                        @label={{t 'aeisApplied'}}
                        @size='small'
                        @fontWeight='medium'
                      />
                    {{/if}}

                    {{#if entry.isLatest}}
                      <AkChip
                        data-test-healthScoreScoringDetails-latestChip
                        local-class='scoring-details-latest-chip'
                        @label={{t 'latest'}}
                        @size='small'
                        @fontWeight='medium'
                      />
                    {{/if}}
                  </AkStack>

                  <AkTypography
                    data-test-healthScoreScoringDetails-entryTitle
                    local-class='scoring-details-entry-title {{if
                      entry.isKnoxiqRan
                      "scoring-details-entry-title--knoxiq"
                    }}'
                    @fontWeight='medium'
                  >
                    {{entry.title}}
                  </AkTypography>

                  <AkTypography @variant='body2' @color='textSecondary'>
                    {{entry.description}}
                  </AkTypography>
                </div>

                <AkTypography
                  data-test-healthScoreScoringDetails-scoreChange
                  local-class='scoring-details-score-change scoring-details-score-change--{{entry.scoreChangeClass}}'
                  @fontWeight='bold'
                >
                  {{entry.scoreChange}}
                </AkTypography>
              </AkStack>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>
  </AkStack>
</AkDrawer>