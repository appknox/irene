<div local-class='severity-level-root'>
  <div local-class='severity-level-header'>
    <AkTypography data-test-fileDetailSeverityLevel-title @variant='subtitle1'>
      {{t 'severityLevel'}}
    </AkTypography>
  </div>

  <AkStack
    local-class='severity-level-body'
    @alignItems='stretch'
    @spacing='3'
  >
    <AkStack local-class='severity-level-chart-section' @alignItems='center'>
      <FileChart
        local-class='severity-level-chart'
        @file={{@file}}
        @legendMaxWidth={{350}}
        @size='large'
      />
    </AkStack>

    {{#if this.hasHealthScore}}
      <AkDivider
        data-test-fileDetailSeverityLevel-divider
        local-class='severity-level-divider'
        @direction='vertical'
      />

      <div local-class='severity-level-health-score-section'>
        <FileDetails::SeverityLevel::HealthScore @file={{@file}} />
      </div>
    {{/if}}
  </AkStack>
</div>