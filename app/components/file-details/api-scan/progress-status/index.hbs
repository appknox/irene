<div
  data-test-fileDetails-apiScan-progressStatus-container
  local-class='progress-status'
  {{did-update this.handleScanProgressChange @file.apiScanProgress}}
  {{did-update this.handleScanProgressChange @file.isApiDone}}
>
  <AkStack
    local-class='scanned-apis-header'
    @alignItems='center'
    @justifyContent='space-between'
    @spacing='2'
    class='px-3 py-2'
  >
    <div>
      <AkTypography
        data-test-fileDetails-apiScan-progressStatus-title
        @variant='h5'
      >
        {{t 'apiScanModule.scannedApis'}}
      </AkTypography>

      <AkTypography
        data-test-fileDetails-apiScan-progressStatus-scannedCount
        @variant='body2'
        @color='textSecondary'
      >
        {{t
          'apiScanModule.endpointsScannedCount'
          scanned=this.scannedCount
          total=this.totalCount
        }}
      </AkTypography>
    </div>

    <AkStack @alignItems='center' @spacing='2'>
      {{#if @file.isRunningApiScan}}
        <AkStack
          data-test-fileDetails-apiScan-progressStatus-progressText
          local-class='progress-bar'
          @alignItems='center'
          @spacing='2'
        >
          <AkLoader::Linear
            local-class='progress-bar-indicator'
            @progress={{@file.apiScanProgress}}
            @variant='determinate'
          />

          <AkTypography local-class='progress-percent' @variant='h6'>
            {{@file.apiScanProgress}}%
          </AkTypography>
        </AkStack>
      {{/if}}

      <div local-class='search-input'>
        <AkTextField
          data-test-fileDetails-apiScan-progressStatus-searchInput
          @placeholder={{t 'apiScanModule.searchEndpoints'}}
          {{on 'keyup' this.handleSearchInput}}
        >
          <:leftAdornment>
            <AkIcon @iconName='search' @color='textSecondary' />
          </:leftAdornment>
        </AkTextField>
      </div>

      {{#if @file.isApiScanStopRequested}}
        <FileDetails::DynamicScan::StatusChip
          data-test-fileDetails-apiScan-stoppingChip
          @status={{this.stoppingStatus}}
        />
      {{else if @file.isRunningApiScan}}
        <AkButton
          data-test-fileDetails-apiScan-stopBtn
          {{on 'click' (perform this.stopApiScan)}}
          @disabled={{or (not @file.isActive) this.stopApiScan.isRunning}}
          @loading={{this.stopApiScan.isRunning}}
        >
          <:leftIcon>
            {{#if this.stopApiScan.isRunning}}
              <AkLoader @size={{13}} />
            {{else}}
              <AkIcon @iconName='stop-circle' />
            {{/if}}
          </:leftIcon>

          <:default>
            {{t 'stop'}}
          </:default>
        </AkButton>
      {{else if @file.isApiDone}}
        <AkChip
          data-test-fileDetails-apiScan-progressStatus-completedChip
          @variant='semi-filled'
          @label={{t 'chipStatus.completed'}}
          @color='success'
        />
      {{/if}}
    </AkStack>
  </AkStack>

  {{#if this.showListLoading}}
    <AkTable::Loading @columns={{this.columns}} />
  {{else if this.hasNoScanUrls}}
    <AkStack
      data-test-fileDetails-apiScan-progressStatus-empty
      local-class='scanned-apis-empty'
      @direction='column'
      @alignItems='center'
      class='p-4'
    >
      <AkTypography @variant='h6' @gutterBottom={{true}}>
        {{t 'apiScanModule.noApiFound'}}
      </AkTypography>
    </AkStack>
  {{else}}
    <AkPaginationProvider
      @results={{this.scanUrls}}
      @onItemPerPageChange={{this.handleItemPerPageChange}}
      @totalItems={{this.filteredCount}}
      @nextAction={{this.handlePrevNextAction}}
      @prevAction={{this.handlePrevNextAction}}
      @itemPerPageOptions={{array 10 25 50}}
      @defaultLimit={{this.limit}}
      @offset={{this.offset}}
      as |pgc|
    >
      <AkTable
        data-test-fileDetails-apiScan-progressStatus-table
        local-class='scanned-apis-table'
        as |t|
      >
        {{! Lock the table to the container width and let Endpoint absorb the difference, so Method stays narrow and Scanned At sits at the right edge without a horizontal scroll }}
        <t.head
          @columns={{this.columns}}
          @widthConstraint='eq-container'
          @fillMode='nth-column'
          @fillColumnIndex={{1}}
        />
        <t.body @rows={{pgc.currentPageResults}} as |b|>
          <b.row data-test-fileDetails-apiScan-progressStatus-row as |r|>
            <r.cell>
              {{#if (eq r.columnValue.id 'method')}}
                <AkChip
                  data-test-fileDetails-apiScan-progressStatus-method
                  @variant='semi-filled'
                  @size='small'
                  @label={{r.rowValue.request.method}}
                  @color={{this.methodChipColor r.rowValue.request.method}}
                />
              {{else if (eq r.columnValue.id 'endpoint')}}
                <AkTypography
                  data-test-fileDetails-apiScan-progressStatus-endpoint
                  title={{request-to-url r.rowValue.request}}
                  @noWrap={{true}}
                >
                  {{request-to-url r.rowValue.request}}
                </AkTypography>
              {{else if (eq r.columnValue.id 'status')}}
                {{#let (this.statusDetails r.rowValue.status) as |status|}}
                  <AkStack
                    data-test-fileDetails-apiScan-progressStatus-status
                    @alignItems='center'
                    @spacing='1'
                  >
                    <span
                      local-class='status-dot status-dot-{{status.color}}'
                    ></span>

                    <AkTypography
                      local-class='status-text status-text-{{status.color}}'
                    >
                      {{status.label}}
                    </AkTypography>
                  </AkStack>
                {{/let}}
              {{else}}
                <AkTypography
                  data-test-fileDetails-apiScan-progressStatus-scannedOn
                  title={{this.formatScannedOnTitle r.rowValue.scanned_on}}
                  @color='textSecondary'
                >
                  {{this.formatScannedOn r.rowValue.scanned_on}}
                </AkTypography>
              {{/if}}
            </r.cell>
          </b.row>
        </t.body>
      </AkTable>

      <AkPagination
        @disableNext={{pgc.disableNext}}
        @nextAction={{pgc.nextAction}}
        @disablePrev={{pgc.disablePrev}}
        @prevAction={{pgc.prevAction}}
        @endItemIdx={{pgc.endItemIdx}}
        @startItemIdx={{pgc.startItemIdx}}
        @itemPerPageOptions={{pgc.itemPerPageOptions}}
        @onItemPerPageChange={{pgc.onItemPerPageChange}}
        @selectedOption={{pgc.selectedOption}}
        @tableItemLabel={{t 'apis'}}
        @perPageTranslation={{t 'recordPerPage'}}
        @totalItems={{pgc.totalItems}}
      />
    </AkPaginationProvider>
  {{/if}}
</div>