<section
  local-class='panel {{if this.hubspot.isOpen "open"}}'
  aria-label={{t 'chatSupport'}}
  aria-hidden={{if this.hubspot.isOpen 'false' 'true'}}
  data-test-hubspotChat-panel
  ...attributes
>
  <AkIconButton
    local-class='close-btn'
    aria-label={{t 'close'}}
    {{on 'click' this.handleClose}}
    data-test-hubspotChat-closeBtn
  >
    <AkIcon @iconName='close' />
  </AkIconButton>

  {{! HubSpot renders the chat inside this element (inlineEmbedSelector). }}
  <div
    id={{this.hubspot.EMBED_ID}}
    local-class='embed'
    {{did-insert this.hubspot.handleEmbedInserted}}
    data-test-hubspotChat-embed
  ></div>
</section>