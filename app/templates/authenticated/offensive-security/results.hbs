{{page-title (t 'offensiveSecurity.results')}}

<PageWrapper @backgroundColor='dark'>
  <div class='offsec-type'>
    <OffensiveSecurity::RunResults
      @scan={{@model}}
      @activeGoalParam={{this.goal}}
      @onGoalParamChange={{this.handleGoalParamChange}}
      @activeViewParam={{this.view}}
      @onViewParamChange={{this.handleViewParamChange}}
    />
  </div>
</PageWrapper>